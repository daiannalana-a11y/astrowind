---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Programa 5S com Implantação | Organização e Padronização Operacional | Triaxis',
  description: 'Implantação do Programa 5S com diagnóstico, padrões visuais, treinamento de equipe e acompanhamento. Organização, limpeza e disciplina operacional para indústrias e empresas em MG. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/producao" class="hover:text-[#3a8d44] transition-colors">Engenharia de Produção</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Programa 5S</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia de Produção</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Programa 5S: <span class="text-[#6fcf7f]">organização, padronização e disciplina que ficam na operação</span>
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Implantação estruturada do Programa 5S com diagnóstico, padrões visuais, treinamento de equipe e acompanhamento — para que a mudança se sustente no dia a dia, não apenas na semana de implantação.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-8">
        {[
          'Diagnóstico do estado atual com fotos e registro',
          'Padrões visuais e procedimentos para cada senso',
          'Treinamento prático da equipe',
          'Acompanhamento e auditorias de sustentação',
          'Base para implantação de Lean Manufacturing',
        ].map(item => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/20">
            <Icon name="tabler:check" class="w-3.5 h-3.5 text-[#6fcf7f]" />
            {item}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20implantar%20o%20Programa%205S%20na%20minha%20empresa.%20Empresa:%20____%20%7C%20Setor:%20____%20%7C%20Cidade:%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Implantar o Programa 5S
        </a>
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20uma%20proposta%20para%20o%20Programa%205S."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Solicitar proposta (24h)
        </a>
      </div>
    </div>
  </section>

  <!-- OS 5 SENSOS -->
  <section class="bg-[#1a3044] py-12 px-4 border-t border-white/10">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 tx-fade">
        {[
          { sigla: 'S1', nome: 'Seiri', traducao: 'Utilização', desc: 'Separar o necessário do desnecessário e eliminar o que não agrega.' },
          { sigla: 'S2', nome: 'Seiton', traducao: 'Organização', desc: 'Um lugar para cada coisa e cada coisa em seu lugar.' },
          { sigla: 'S3', nome: 'Seiso', traducao: 'Limpeza', desc: 'Limpar e identificar fontes de sujeira e deterioração.' },
          { sigla: 'S4', nome: 'Seiketsu', traducao: 'Padronização', desc: 'Estabelecer padrões visuais para manter os três primeiros sensos.' },
          { sigla: 'S5', nome: 'Shitsuke', traducao: 'Disciplina', desc: 'Cumprir e sustentar os padrões como rotina da operação.' },
        ].map(({ sigla, nome, traducao, desc }) => (
          <div class="bg-white/10 rounded-2xl p-4 border border-white/10 text-center">
            <div class="w-10 h-10 rounded-xl bg-[#3a8d44] flex items-center justify-center mx-auto mb-2">
              <span class="text-white font-black text-sm">{sigla}</span>
            </div>
            <p class="text-[#6fcf7f] font-bold text-xs mb-0.5">{nome}</p>
            <p class="text-white font-bold text-xs mb-2">{traducao}</p>
            <p class="text-slate-400 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PARA QUEM + QUANDO -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Segmentos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Para quem o 5S é indicado</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
        <div class="space-y-3">
          {[
            { icon: 'tabler:building-factory', text: 'Indústrias que querem organização sustentável do chão de fábrica' },
            { icon: 'tabler:tool', text: 'Oficinas, serralherias e metalúrgicas com layout desorganizado' },
            { icon: 'tabler:package', text: 'Almoxarifados, estoques e áreas de expedição com problemas de controle' },
            { icon: 'tabler:clipboard-list', text: 'Empresas que querem preparar o terreno para Lean Manufacturing' },
            { icon: 'tabler:users', text: 'Gestores que precisam de base antes de implantar qualidade ou certificações' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-slate-100">
              <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600">{text}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Quando implantar</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Sinais de que o 5S é necessário</h2>
        <div class="w-12 h-1 bg-orange-500 rounded-full mb-5"></div>
        <div class="space-y-3">
          {[
            'Dificuldade para encontrar ferramentas, materiais ou documentos',
            'Espaço desorganizado que compromete segurança e produtividade',
            'Retrabalho por uso de material incorreto ou fora do lugar',
            'Ambiente sujo com fontes de contaminação não controladas',
            'Falta de padrão visual que permita identificar anomalias rapidamente',
            'Antes de qualquer projeto de melhoria contínua ou certificação',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-l-4 border-l-orange-400 border-slate-100">
              <Icon name="tabler:alert-triangle" class="w-4 h-4 text-orange-400 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-600">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS 3 FASES -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Como a Triaxis implanta o 5S</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            fase: 'Diagnóstico',
            icon: 'tabler:stethoscope',
            destaque: false,
            itens: [
              'Visita técnica e levantamento fotográfico do estado atual',
              'Avaliação de cada área por senso',
              'Identificação de pontos críticos e prioridades',
              'Relatório de diagnóstico com pontuação por área',
            ],
          },
          {
            fase: 'Implantação',
            icon: 'tabler:settings',
            destaque: false,
            itens: [
              'Mutirão de descarte e organização das áreas',
              'Definição de layout, identificações e padrões visuais',
              'Treinamento prático da equipe por área',
              'Elaboração de padrões e procedimentos por senso',
            ],
          },
          {
            fase: 'Sustentação',
            icon: 'tabler:refresh',
            destaque: true,
            itens: [
              'Auditoria de 5S com formulário padronizado',
              'Pontuação por área e acompanhamento de evolução',
              'Orientação para líderes e responsáveis por área',
              'Plano de manutenção e melhoria contínua do 5S',
            ],
          },
        ].map(({ fase, icon, destaque, itens }) => (
          <div class={`relative rounded-2xl p-6 bg-slate-50 ${destaque ? 'border-2 border-[#3a8d44]' : 'border border-slate-100'}`}>
            {destaque && (
              <div class="absolute -top-3 right-4">
                <span class="bg-[#3a8d44] text-white text-xs font-bold px-3 py-1 rounded-full">Recomendado</span>
              </div>
            )}
            <div class={`w-9 h-9 rounded-lg flex items-center justify-center mb-4 ${destaque ? 'bg-[#3a8d44]' : 'bg-[#1a3044]'}`}>
              <Icon name={icon} class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-sm font-bold text-[#1a3044] mb-3">{fase}</h3>
            <ul class="space-y-2">
              {itens.map(item => (
                <li class="flex items-start gap-2">
                  <Icon name="tabler:check" class="w-3.5 h-3.5 text-[#3a8d44] flex-shrink-0 mt-0.5" />
                  <span class="text-xs text-slate-600">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ETAPAS -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Processo</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Etapas da implantação do 5S</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { num: '01', titulo: 'Alinhamento e escopo', desc: 'Definição das áreas, equipe envolvida e cronograma de implantação.' },
          { num: '02', titulo: 'Diagnóstico e registro', desc: 'Visita técnica, fotos e avaliação do estado atual por área e senso.' },
          { num: '03', titulo: 'Treinamento de equipe', desc: 'Capacitação prática sobre os 5 sensos e o papel de cada colaborador.' },
          { num: '04', titulo: 'Mutirão de descarte', desc: 'Execução do Seiri: separação e descarte do desnecessário nas áreas.' },
          { num: '05', titulo: 'Organização e identificação', desc: 'Seiton e Seiso: definição de lugares, endereços e padrões visuais.' },
          { num: '06', titulo: 'Elaboração de padrões', desc: 'Criação de procedimentos e padrões visuais para manter os sensos.' },
          { num: '07', titulo: 'Auditoria inicial', desc: 'Primeira auditoria com pontuação de cada área e registro fotográfico.' },
          { num: '08', titulo: 'Acompanhamento', desc: 'Auditorias periódicas e orientação para sustentação dos padrões.' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-5 border border-white/10 flex gap-4">
            <span class="text-2xl font-black text-[#3a8d44] opacity-50 flex-shrink-0 leading-none">{num}</span>
            <div>
              <h3 class="text-white font-bold text-sm mb-1">{titulo}</h3>
              <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRAZOS + NÃO INCLUI -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazo típico do Programa 5S</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            { prazo: '15 a 30 dias', desc: 'Área única ou empresa pequena com até 20 colaboradores.' },
            { prazo: '30 a 60 dias', desc: 'Empresas de porte médio com múltiplas áreas e equipes.' },
            { prazo: 'Acima de 60 dias', desc: 'Operações complexas com muitas áreas ou plantas distintas.' },
          ].map(({ prazo, desc }) => (
            <div class="bg-white rounded-xl p-4 border border-slate-100">
              <p class="text-sm font-bold text-[#1a3044] mb-1">{prazo}</p>
              <p class="text-xs text-slate-500">{desc}</p>
            </div>
          ))}
        </div>
        <p class="text-xs text-slate-400 italic mt-4">O prazo de sustentação é contínuo e definido conforme o plano de auditorias acordado com a empresa.</p>
      </div>
      <div>
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Transparência</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">O que não está incluso</h2>
        <div class="w-12 h-1 bg-orange-500 rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            'Obras, reformas ou adequações físicas nas áreas',
            'Compra de materiais de identificação, etiquetas e armários',
            'Descarte, transporte e destinação de materiais removidos',
            'Redesenho de layout (pode ser contratado separadamente)',
            'Treinamentos adicionais além do escopo acordado',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-3 border border-slate-100">
              <Icon name="tabler:x" class="w-4 h-4 text-slate-300 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-500">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Dúvidas</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Perguntas frequentes sobre o 5S</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full"></div>
      </div>
      <div class="space-y-4">
        {[
          { p: 'O 5S serve para qualquer tipo de empresa?', r: 'Sim. O 5S é aplicável a indústrias, oficinas, escritórios, laboratórios e qualquer operação com espaço físico, materiais e equipe. O escopo é ajustado à realidade de cada empresa.' },
          { p: 'Preciso parar a operação para implantar o 5S?', r: 'Não é necessário parar a operação. O mutirão de descarte e a organização são planejados para causar o menor impacto possível no fluxo de produção.' },
          { p: 'Quanto custa o Programa 5S?', r: 'O valor depende do número de áreas, do porte da empresa e do escopo contratado (diagnóstico, implantação e/ou sustentação). A proposta é enviada com escopo e entregáveis detalhados.' },
          { p: 'Vocês atendem minha cidade?', r: 'O atendimento presencial cobre Ouro Preto, Mariana e Belo Horizonte. Para outras regiões de Minas Gerais, avaliamos a viabilidade conforme o escopo e o porte da empresa.' },
          { p: 'O 5S se sustenta após a implantação?', r: 'A sustentação depende da disciplina da equipe e das auditorias periódicas. Por isso, a fase de sustentação faz parte do escopo recomendado — ela é o que garante que o 5S vira rotina, não apenas um evento.' },
          { p: 'O 5S é obrigatório para certificações como ISO 9001?', r: 'Não é obrigatório, mas é altamente recomendado. Um ambiente organizado e padronizado facilita a implementação de sistemas de gestão da qualidade e auditorias de certificação.' },
          { p: 'O 5S resolve problemas de segurança no trabalho?', r: 'O 5S contribui diretamente para a segurança ao eliminar riscos de queda, contaminação e acidentes por desorganização. Mas não substitui o PGR e os demais documentos de Segurança do Trabalho.' },
          { p: 'A Triaxis fornece os materiais de identificação?', r: 'Não. A Triaxis elabora os padrões e layouts de identificação, mas a compra e instalação dos materiais (etiquetas, sinalizações, armários) fica por conta da empresa.' },
          { p: 'O 5S funciona para pequenas empresas com poucos funcionários?', r: 'Sim. Operações pequenas costumam ter retorno rápido com o 5S, pois o esforço é menor e o impacto na rotina é imediato.' },
          { p: 'Qual o próximo passo depois do 5S?', r: 'O 5S é a base. A partir dele, a empresa está pronta para avançar com VSM, Kaizen, gestão de indicadores, layout industrial e outros projetos de melhoria contínua.' },
        ].map(({ p, r }) => (
          <details class="bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none">
              <span class="text-sm font-bold text-[#1a3044]">{p}</span>
              <Icon name="tabler:chevron-down" class="w-4 h-4 text-slate-400 flex-shrink-0 group-open:rotate-180 transition-transform" />
            </summary>
            <div class="px-5 pb-5">
              <p class="text-sm text-slate-600 leading-relaxed">{r}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center tx-fade">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Organização que fica</p>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Agende a implantação do Programa 5S na sua empresa.
      </h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        Um ambiente organizado e padronizado reduz desperdício, melhora segurança e prepara a operação para crescer com controle. Atendemos Ouro Preto, Mariana, Belo Horizonte e Minas Gerais.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20implantar%20o%20Programa%205S%20na%20minha%20empresa.%20Empresa:%20____%20%7C%20Setor:%20____%20%7C%20Cidade:%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Implantar o Programa 5S
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors">
          Enviar mensagem
        </a>
      </div>
    </div>
  </section>

  <Footer {...footerData} />
</Layout>
