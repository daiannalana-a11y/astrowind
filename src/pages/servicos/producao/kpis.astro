---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'KPIs e Indicadores de Desempenho Operacional | Estruturação e Implantação | Triaxis',
  description: 'Estruturação de KPIs e sistema de indicadores operacionais para indústrias e empresas. OEE, produtividade, qualidade, entrega e custos. Painel de gestão e rotina de acompanhamento. Triaxis Consultoria MG.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/producao" class="hover:text-[#3a8d44] transition-colors">Engenharia de Produção</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">KPIs e Indicadores</span>
    </div>
  </nav>

  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia de Produção</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        KPIs e Indicadores: <span class="text-[#6fcf7f]">meça o que importa e tome decisões com base em dados reais</span>
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Estruturação de um sistema de indicadores operacionais conectado à estratégia da empresa — com KPIs definidos, painel de gestão, metas e rotina de acompanhamento para que os números orientem decisões, não fiquem no relatório.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-8">
        {[
          'KPIs alinhados aos objetivos da operação',
          'Painel de indicadores com visualização clara',
          'Metas definidas com critério técnico',
          'Rotina de reunião e análise de resultados',
          'Indicadores de produtividade, qualidade, entrega e custo',
        ].map(item => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/20">
            <Icon name="tabler:check" class="w-3.5 h-3.5 text-[#6fcf7f]" />
            {item}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20estruturar%20os%20KPIs%20da%20minha%20operação.%20Empresa:%20____%20%7C%20Setor:%20____%20%7C%20Cidade:%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Estruturar KPIs da operação
        </a>
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20uma%20proposta%20para%20KPIs%20e%20indicadores."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Solicitar proposta (24h)
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Definição</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é estruturação de KPIs</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          KPIs (Key Performance Indicators) são indicadores-chave de desempenho que permitem monitorar se a operação está atingindo seus objetivos. Um sistema de KPIs bem estruturado vai além de medir: ele conecta o chão de fábrica à estratégia, orienta decisões e revela onde a operação precisa de atenção antes que o problema se agrave.
        </p>
        <p class="text-slate-600 leading-relaxed mb-6">
          Muitas empresas têm dados, mas não têm indicadores. Ou têm indicadores que ninguém acompanha. A Triaxis estrutura um sistema de KPIs aplicável à realidade da operação, com metas definidas, responsáveis claros e rotina de análise.
        </p>
        <div class="space-y-3">
          {[
            'Tomada de decisão embasada em dados confiáveis e atualizados',
            'Identificação precoce de desvios antes que se tornem perdas',
            'Alinhamento entre gestão e operação sobre o que é prioridade',
            'Base para projetos de melhoria com critério e rastreabilidade',
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon name="tabler:check" class="w-3 h-3 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600">{item}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">Dimensões dos indicadores</p>
        <div class="space-y-4">
          {[
            { icon: 'tabler:trending-up', label: 'Produtividade', desc: 'OEE, volume produzido, eficiência de linha, utilização de capacidade.' },
            { icon: 'tabler:circle-check', label: 'Qualidade', desc: 'Taxa de defeitos, rejeição, retrabalho, reclamações de clientes.' },
            { icon: 'tabler:truck', label: 'Entrega', desc: 'On-time delivery, lead time de produção, aderência ao plano.' },
            { icon: 'tabler:coin', label: 'Custos', desc: 'Custo por unidade, perdas de processo, consumo de insumos.' },
            { icon: 'tabler:users', label: 'Pessoas', desc: 'Absenteísmo, produtividade por operador, horas extras.' },
          ].map(({ icon, label, desc }) => (
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
              </div>
              <div>
                <p class="text-xs font-bold text-[#1a3044]">{label}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Quando contratar</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Situações que indicam necessidade de estruturar KPIs</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
        <div class="space-y-3">
          {[
            'Decisões tomadas sem base em dados confiáveis',
            'Indicadores existentes que ninguém acompanha ou usa',
            'Dificuldade para identificar onde a operação está perdendo',
            'Falta de metas claras e acordadas com a equipe',
            'Crescimento da empresa sem estrutura de monitoramento',
            'Implantação de Lean sem sistema de acompanhamento de resultados',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-l-4 border-l-orange-400 border-slate-100">
              <Icon name="tabler:alert-triangle" class="w-4 h-4 text-orange-400 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-600">{item}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="bg-white rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-4">O que a Triaxis entrega</p>
        <div class="space-y-4">
          {[
            { icon: 'tabler:list-check', titulo: 'Mapa de KPIs', desc: 'Lista de indicadores definidos por área, objetivo e responsável.' },
            { icon: 'tabler:calculator', titulo: 'Fichas de indicadores', desc: 'Definição, fórmula de cálculo, fonte de dados e meta de cada KPI.' },
            { icon: 'tabler:layout-dashboard', titulo: 'Painel de gestão', desc: 'Dashboard visual com os KPIs prioritários para acompanhamento.' },
            { icon: 'tabler:target', titulo: 'Definição de metas', desc: 'Metas técnicas alinhadas à capacidade e aos objetivos da empresa.' },
            { icon: 'tabler:calendar', titulo: 'Rotina de gestão', desc: 'Cadência de reuniões, responsáveis e rituais de análise de resultados.' },
          ].map(({ icon, titulo, desc }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <div>
                <p class="text-sm font-bold text-[#1a3044] mb-1">{titulo}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Processo</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona a estruturação de KPIs</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { num: '01', titulo: 'Alinhamento estratégico', desc: 'Entendimento dos objetivos da empresa e das prioridades da operação.' },
          { num: '02', titulo: 'Diagnóstico de dados disponíveis', desc: 'Levantamento do que já é medido e do que pode ser coletado.' },
          { num: '03', titulo: 'Definição dos KPIs', desc: 'Seleção e definição dos indicadores por área e objetivo, com fórmula e fonte.' },
          { num: '04', titulo: 'Definição de metas', desc: 'Estabelecimento de metas técnicas com base em histórico e benchmarks.' },
          { num: '05', titulo: 'Construção do painel', desc: 'Desenvolvimento do dashboard de gestão com visualização dos KPIs.' },
          { num: '06', titulo: 'Treinamento e implantação', desc: 'Capacitação da equipe para coleta, análise e uso dos indicadores.' },
          { num: '07', titulo: 'Acompanhamento inicial', desc: 'Suporte nas primeiras rodadas de análise para consolidar a rotina.' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-5 border border-white/10 flex gap-4">
            <span class="text-2xl font-black text-[#3a8d44] opacity-50 flex-shrink-0 leading-none">{num}</span>
            <div>
              <h3 class="text-white font-bold text-sm mb-1">{titulo}</h3>
              <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazo típico da estruturação de KPIs</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            { prazo: '10 a 20 dias', desc: 'Operação simples com poucas áreas e dados disponíveis.' },
            { prazo: '20 a 40 dias', desc: 'Empresas de porte médio com múltiplas áreas e KPIs a estruturar.' },
            { prazo: 'Acima de 40 dias', desc: 'Operações complexas com múltiplas plantas ou integração com ERP.' },
          ].map(({ prazo, desc }) => (
            <div class="bg-white rounded-xl p-4 border border-slate-100">
              <p class="text-sm font-bold text-[#1a3044] mb-1">{prazo}</p>
              <p class="text-xs text-slate-500">{desc}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Transparência</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">O que não está incluso</h2>
        <div class="w-12 h-1 bg-orange-500 rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            'Desenvolvimento de sistemas de TI ou integração com ERP',
            'Coleta automática de dados (requer infraestrutura de TI)',
            'Acompanhamento contínuo após a implantação (pode ser contratado)',
            'Treinamentos além do escopo de implantação acordado',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-3 border border-slate-100">
              <Icon name="tabler:x" class="w-4 h-4 text-slate-300 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-500">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Dúvidas</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Perguntas frequentes sobre KPIs</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full"></div>
      </div>
      <div class="space-y-4">
        {[
          { p: 'Quantos KPIs a empresa deve ter?', r: 'Não existe número ideal fixo. O critério é ter o mínimo suficiente para monitorar os objetivos prioritários. Painéis com muitos indicadores tendem a não ser usados. A Triaxis ajuda a selecionar os KPIs que realmente orientam decisão.' },
          { p: 'Preciso de sistema ou software para usar KPIs?', r: 'Não necessariamente. É possível implantar um sistema eficiente de KPIs com planilhas bem estruturadas. O importante é que a coleta seja confiável e a rotina de análise seja mantida.' },
          { p: 'O que é OEE e quando usar?', r: 'OEE (Overall Equipment Effectiveness) mede a eficiência global de equipamentos, combinando disponibilidade, desempenho e qualidade. É indicado para operações com máquinas ou linhas de produção como foco da eficiência.' },
          { p: 'Vocês atendem minha cidade?', r: 'O atendimento presencial cobre Ouro Preto, Mariana e Belo Horizonte. Para outras cidades de Minas Gerais, o trabalho pode ser feito remotamente em grande parte.' },
          { p: 'Quanto custa a estruturação de KPIs?', r: 'O valor depende do número de áreas, da complexidade da operação e do escopo (só definição de KPIs ou inclui dashboard e treinamento). A proposta é enviada com escopo detalhado.' },
          { p: 'A Triaxis faz o acompanhamento dos indicadores após a implantação?', r: 'Sim. O acompanhamento contínuo pode ser contratado separadamente como assessoria periódica, com análise dos resultados e orientação para ações corretivas.' },
          { p: 'Os KPIs estruturados pela Triaxis são integrados ao nosso sistema de gestão?', r: 'A Triaxis define a lógica dos KPIs e orienta a estruturação. A integração técnica com sistemas ERP ou de TI específicos depende da infraestrutura da empresa e pode exigir profissionais de TI.' },
          { p: 'É possível estruturar KPIs sem ter dados históricos?', r: 'Sim. Em empresas sem histórico estruturado, o ponto de partida é definir os KPIs, implantar a coleta de dados e estabelecer as primeiras metas com base em benchmarks e na capacidade atual.' },
          { p: 'KPIs servem apenas para a operação?', r: 'Não. KPIs podem ser estruturados para qualquer área: produção, qualidade, logística, comercial, financeiro. O escopo é definido conforme a necessidade da empresa.' },
          { p: 'Como saber se os KPIs que já uso estão corretos?', r: 'Um KPI correto é aquele que mede algo relevante para um objetivo, tem fórmula clara, fonte de dados confiável, meta definida e responsável que o analisa e age. A Triaxis pode fazer uma revisão crítica dos indicadores existentes.' },
        ].map(({ p, r }) => (
          <details class="bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none">
              <span class="text-sm font-bold text-[#1a3044]">{p}</span>
              <Icon name="tabler:chevron-down" class="w-4 h-4 text-slate-400 flex-shrink-0 group-open:rotate-180 transition-transform" />
            </summary>
            <div class="px-5 pb-5">
              <p class="text-sm text-slate-600 leading-relaxed">{r}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center tx-fade">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Gestão com base em dados reais</p>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Estruture os indicadores da sua operação.
      </h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        O que não é medido não é gerenciado. Com KPIs certos, a operação sabe onde está, onde quer chegar e o que precisa mudar. Atendemos Ouro Preto, Mariana, Belo Horizonte e Minas Gerais.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20estruturar%20os%20KPIs%20da%20minha%20operação.%20Empresa:%20____%20%7C%20Setor:%20____%20%7C%20Cidade:%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Estruturar KPIs da operação
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors">
          Enviar mensagem
        </a>
      </div>
    </div>
  </section>

  <Footer {...footerData} />
</Layout>
