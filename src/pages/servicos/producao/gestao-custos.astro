---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Gestão de Custos Industriais | Análise e Redução de Custos de Produção | Triaxis',
  description: 'Análise e estruturação de custos industriais para identificar perdas, ineficiências e oportunidades de redução. Custo por produto, por processo e por área. Triaxis Consultoria MG.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/producao" class="hover:text-[#3a8d44] transition-colors">Engenharia de Produção</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Gestão de Custos</span>
    </div>
  </nav>

  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia de Produção</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Gestão de Custos: <span class="text-[#6fcf7f]">identifique perdas, estruture custos e aumente a margem da operação</span>
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Análise técnica dos custos de produção para revelar onde a operação perde margem — com estruturação do custo por produto, por processo e por área, e identificação de oportunidades concretas de redução.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-8">
        {[
          'Mapeamento dos custos diretos e indiretos da operação',
          'Custo real por produto ou família de produtos',
          'Identificação de perdas e ineficiências com impacto financeiro',
          'Oportunidades priorizadas de redução de custos',
          'Base para precificação e decisões de mix de produtos',
        ].map(item => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/20">
            <Icon name="tabler:check" class="w-3.5 h-3.5 text-[#6fcf7f]" />
            {item}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20analisar%20os%20custos%20da%20minha%20operação.%20Empresa:%20____%20%7C%20Setor:%20____%20%7C%20Cidade:%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Analisar custos da operação
        </a>
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20uma%20proposta%20para%20Gestão%20de%20Custos."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Solicitar proposta (24h)
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Definição</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é gestão de custos industriais</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          Gestão de custos industriais é o processo de identificar, estruturar e analisar todos os custos envolvidos na produção — mão de obra, materiais, energia, manutenção, perdas, refugos e custos indiretos — para entender o custo real de cada produto ou processo e agir sobre as ineficiências.
        </p>
        <p class="text-slate-600 leading-relaxed mb-6">
          Muitas empresas precificam sem saber o custo real, ou sabem que perdem margem, mas não sabem onde. A análise técnica de custos revela o que os relatórios financeiros não mostram com clareza suficiente para a tomada de decisão operacional.
        </p>
        <div class="space-y-3">
          {[
            'Custo real por produto para precificação e decisão de mix',
            'Identificação das maiores perdas e onde elas ocorrem',
            'Base técnica para negociações de insumos e contratos',
            'Clareza sobre o impacto financeiro de cada decisão operacional',
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon name="tabler:check" class="w-3 h-3 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600">{item}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">Categorias de custo analisadas</p>
        <div class="space-y-4">
          {[
            { icon: 'tabler:users', label: 'Mão de obra direta e indireta', desc: 'Custo por hora, eficiência, ociosidade e horas extras.' },
            { icon: 'tabler:package', label: 'Materiais e insumos', desc: 'Consumo real versus padrão, perdas e variações de preço.' },
            { icon: 'tabler:bolt', label: 'Energia e utilidades', desc: 'Consumo por equipamento, por turno e por produto.' },
            { icon: 'tabler:tool', label: 'Manutenção', desc: 'Custo de manutenção corretiva e preventiva e seu impacto na produção.' },
            { icon: 'tabler:x', label: 'Perdas e refugos', desc: 'Custo de não-qualidade: retrabalho, refugo e devoluções.' },
          ].map(({ icon, label, desc }) => (
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
              </div>
              <div>
                <p class="text-xs font-bold text-[#1a3044]">{label}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">O que a Triaxis entrega na análise de custos</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { icon: 'tabler:map-2', titulo: 'Mapeamento de custos', desc: 'Estrutura completa dos custos diretos e indiretos da operação.' },
          { icon: 'tabler:calculator', titulo: 'Custo por produto/processo', desc: 'Custo real calculado por produto, família ou etapa de processo.' },
          { icon: 'tabler:chart-bar', titulo: 'Análise de perdas', desc: 'Identificação e quantificação financeira das perdas por categoria.' },
          { icon: 'tabler:timeline', titulo: 'Oportunidades de redução', desc: 'Ações priorizadas por impacto financeiro, esforço e prazo de retorno.' },
          { icon: 'tabler:file-report', titulo: 'Relatório técnico', desc: 'Documento com análise, conclusões e recomendações.' },
          { icon: 'tabler:presentation', titulo: 'Reunião de devolutiva', desc: 'Apresentação dos resultados com orientações sobre próximos passos.' },
        ].map(({ icon, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-5 border border-white/10 flex gap-4">
            <div class="w-9 h-9 rounded-lg bg-[#3a8d44]/30 flex items-center justify-center flex-shrink-0">
              <Icon name={icon} class="w-5 h-5 text-[#6fcf7f]" />
            </div>
            <div>
              <h3 class="text-white font-bold text-sm mb-1">{titulo}</h3>
              <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazo típico da análise de custos</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            { prazo: '10 a 20 dias', desc: 'Operação simples com dados financeiros e operacionais disponíveis.' },
            { prazo: '20 a 40 dias', desc: 'Empresas de porte médio com múltiplos produtos ou processos.' },
            { prazo: 'Acima de 40 dias', desc: 'Operações complexas com múltiplas linhas, turnos ou plantas.' },
          ].map(({ prazo, desc }) => (
            <div class="bg-white rounded-xl p-4 border border-slate-100">
              <p class="text-sm font-bold text-[#1a3044] mb-1">{prazo}</p>
              <p class="text-xs text-slate-500">{desc}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Transparência</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">O que não está incluso</h2>
        <div class="w-12 h-1 bg-orange-500 rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            'Contabilidade de custos e escrituração fiscal',
            'Implantação das ações de redução identificadas',
            'Desenvolvimento de sistema de custeio em software ERP',
            'Auditoria contábil ou fiscal',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-3 border border-slate-100">
              <Icon name="tabler:x" class="w-4 h-4 text-slate-300 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-500">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Dúvidas</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Perguntas frequentes sobre gestão de custos</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full"></div>
      </div>
      <div class="space-y-4">
        {[
          { p: 'Qual a diferença entre contabilidade de custos e gestão de custos industriais?', r: 'A contabilidade de custos é uma obrigação fiscal e contábil. A gestão de custos industriais foca na análise operacional para decisão — custo por produto, perdas, ineficiências e oportunidades de melhoria. São trabalhos complementares, com objetivos distintos.' },
          { p: 'Preciso fornecer dados financeiros para o serviço?', r: 'Sim. A análise de custos requer acesso a dados de produção (volumes, tempos, consumos) e financeiros (folha, energia, materiais). A Triaxis orienta quais dados são necessários em cada etapa.' },
          { p: 'Vocês atendem minha cidade?', r: 'O atendimento presencial cobre Ouro Preto, Mariana e Belo Horizonte. Para outras regiões de Minas Gerais, boa parte do trabalho pode ser feita remotamente com dados fornecidos pela empresa.' },
          { p: 'Quanto custa o serviço de análise de custos?', r: 'O valor depende do número de produtos, da complexidade do processo e da organização dos dados disponíveis. A proposta é enviada após alinhamento do escopo.' },
          { p: 'A Triaxis faz a precificação dos produtos?', r: 'A análise de custos fornece a base para precificação. A decisão de preço final envolve fatores comerciais e estratégicos que são da responsabilidade da empresa.' },
          { p: 'É possível reduzir custos sem reduzir qualidade?', r: 'Sim. A maior parte das oportunidades de redução está em perdas, ineficiências e desperdícios que não agregam valor ao produto. Eliminar essas perdas reduz custo sem impactar a qualidade entregue.' },
          { p: 'O serviço é indicado para pequenas empresas?', r: 'Sim. Pequenas empresas muitas vezes não conhecem o custo real dos seus produtos e precificam abaixo do necessário para manter a margem. A análise de custos resolve exatamente esse problema.' },
          { p: 'Quanto tempo leva para ver retorno financeiro após a análise?', r: 'Depende das ações implantadas. Reduções operacionais simples (desperdícios, refugo, energia) tendem a ter retorno em semanas. Projetos estruturais levam mais tempo, mas o impacto é maior e mais duradouro.' },
          { p: 'A análise de custos inclui custos de manutenção?', r: 'Sim, quando fazem parte do escopo definido. Custos de manutenção corretiva são uma das maiores fontes de perda oculta em operações industriais.' },
          { p: 'A Triaxis faz a implantação das ações de redução de custos?', r: 'Sim. As ações identificadas na análise podem ser implantadas pela Triaxis em contratação separada, com os projetos de melhoria contínua, layout, 5S ou gestão de qualidade como base.' },
        ].map(({ p, r }) => (
          <details class="bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none">
              <span class="text-sm font-bold text-[#1a3044]">{p}</span>
              <Icon name="tabler:chevron-down" class="w-4 h-4 text-slate-400 flex-shrink-0 group-open:rotate-180 transition-transform" />
            </summary>
            <div class="px-5 pb-5">
              <p class="text-sm text-slate-600 leading-relaxed">{r}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center tx-fade">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Margem começa no processo</p>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Analise os custos da sua operação com a Triaxis.
      </h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        Sem saber o custo real, toda decisão de preço, mix ou investimento é um chute. Com análise técnica, você enxerga onde a margem some e age com precisão. Atendemos Ouro Preto, Mariana, Belo Horizonte e Minas Gerais.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20analisar%20os%20custos%20da%20minha%20operação.%20Empresa:%20____%20%7C%20Setor:%20____%20%7C%20Cidade:%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Analisar custos da operação
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors">
          Enviar mensagem
        </a>
      </div>
    </div>
  </section>

  <Footer {...footerData} />
</Layout>
