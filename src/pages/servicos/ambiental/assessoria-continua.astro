---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Assessoria Ambiental Contínua | Triaxis Consultoria',
  description: 'Acompanhamento ambiental recorrente em Ouro Preto, Mariana e Belo Horizonte. Controle de prazos, licenças, condicionantes, resíduos e documentação durante o ano todo. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Assessoria Ambiental Contínua</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Assessoria Ambiental Contínua: conformidade o ano todo
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Acompanhamento recorrente em Ouro Preto, Mariana, Belo Horizonte e região: controle de prazos, licenças, condicionantes, resíduos e documentação com rotina, relatórios e suporte em fiscalização.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-8">
        {[
          'Diagnóstico inicial + plano de ação',
          'Rotina mensal com checklists, evidências e prazos',
          'Visitas presenciais quando necessárias (conforme plano)',
        ].map(item => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/20">
            <Icon name="tabler:check" class="w-3.5 h-3.5 text-[#6fcf7f]" />
            {item}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20fazer%20um%20diagnóstico%20rápido%20sobre%20a%20situação%20ambiental%20da%20minha%20empresa."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Diagnóstico rápido no WhatsApp
        </a>
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20solicitar%20uma%20proposta%20para%20Assessoria%20Ambiental%20Contínua."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Solicitar proposta (24h)
        </a>
      </div>
    </div>
  </section>

  <!-- O QUE É -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Definição</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é Assessoria Ambiental Contínua</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          Assessoria Ambiental Contínua é um serviço recorrente de consultoria ambiental para manter a empresa regular ao longo do ano, com rotina estruturada, controle de prazos, organização de evidências e suporte técnico permanente. É o suporte técnico disponível antes que o prazo vença ou a fiscalização chegue.
        </p>
        <p class="text-slate-600 leading-relaxed mb-6">
          Em vez de agir de forma reativa, a empresa passa a ter acompanhamento periódico, documentação organizada e um plano de conformidade em execução contínua.
        </p>
        <div class="space-y-3">
          {[
            'Acompanhamento técnico periódico (remoto e/ou presencial)',
            'Controle de licenças, prazos e condicionantes',
            'Organização de resíduos e documentação com evidências',
            'Orientação para auditorias e fiscalizações',
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon name="tabler:check" class="w-3 h-3 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600">{item}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-4">Sem assessoria contínua</p>
        <div class="space-y-3 mb-6">
          {[
            'Licença vence e ninguém acompanhou',
            'Condicionantes sem evidência organizada',
            'Resíduos sem rotina nem documentação',
            'Fiscalização chega sem preparação',
            'Adequações feitas às pressas e com custo elevado',
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-red-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon name="tabler:x" class="w-3 h-3 text-red-400" />
              </div>
              <p class="text-xs text-slate-500">{item}</p>
            </div>
          ))}
        </div>
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-4">Com assessoria contínua</p>
        <div class="space-y-3">
          {[
            'Prazos controlados com antecedência',
            'Evidências organizadas e acessíveis',
            'Rotina de resíduos documentada',
            'Fiscalização com orientação técnica prévia',
            'Conformidade com previsibilidade de prazo e custo',
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon name="tabler:check" class="w-3 h-3 text-[#3a8d44]" />
              </div>
              <p class="text-xs text-slate-600">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PARA QUEM É -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Indicação</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Para quem a Assessoria Ambiental Contínua é indicada</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Ideal para empresas que precisam de conformidade constante e querem previsibilidade de prazo, custo e organização.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-4">Segmentos atendidos</p>
          <div class="space-y-3">
            {[
              { icon: 'tabler:car', text: 'Oficinas mecânicas, funilarias, auto centers e lava-jatos' },
              { icon: 'tabler:building-factory', text: 'Pequenas indústrias, metalúrgicas e serralherias' },
              { icon: 'tabler:bulldozer', text: 'Construtoras, empreiteiras, terraplenagem e prestadores de obra' },
              { icon: 'tabler:truck', text: 'Transportadoras, logística e centros de distribuição' },
              { icon: 'tabler:mountain', text: 'Prestadores de serviços para o setor de mineração' },
            ].map(({ icon, text }) => (
              <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-slate-100">
                <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                  <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
                </div>
                <p class="text-sm text-slate-600">{text}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-4">Situações que indicam necessidade</p>
          <div class="space-y-3">
            {[
              'Licença vencendo e nenhum responsável acompanhou o prazo',
              'Condicionantes exigidas sem evidência organizada para comprovação',
              'Resíduos sem rotina definida de armazenamento, coleta e destinação',
              'Crescimento da operação sem adequação ambiental correspondente',
              'Risco de fiscalização, autuação ou paralisação das atividades',
            ].map(item => (
              <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-l-4 border-l-orange-400 border-slate-100">
                <Icon name="tabler:alert-triangle" class="w-4 h-4 text-orange-400 flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que a empresa recebe na Assessoria Ambiental Contínua</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Entregáveis práticos e aplicáveis à rotina da operação, sem relatórios genéricos desconectados da realidade da empresa.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: 'tabler:stethoscope', titulo: 'Diagnóstico ambiental inicial', desc: 'Levantamento da situação atual com identificação de prioridades e riscos' },
          { icon: 'tabler:list-check', titulo: 'Mapeamento de obrigações', desc: 'Obrigações aplicáveis por atividade, porte e localidade' },
          { icon: 'tabler:timeline', titulo: 'Plano de ação de conformidade', desc: 'Ações definidas para curto, médio e longo prazo' },
          { icon: 'tabler:calendar-stats', titulo: 'Calendário de compliance', desc: 'Controle de prazos, licenças e condicionantes com alertas' },
          { icon: 'tabler:clipboard-list', titulo: 'Checklists de evidências', desc: 'O que guardar, como e onde para comprovar conformidade' },
          { icon: 'tabler:trash', titulo: 'Plano básico de gestão de resíduos', desc: 'Orientações e padronização interna de rotina de resíduos' },
          { icon: 'tabler:file-report', titulo: 'Relatórios periódicos', desc: 'Mensal ou bimestral conforme o plano contratado' },
          { icon: 'tabler:eye', titulo: 'Orientação para fiscalizações', desc: 'Apoio técnico antes e após visitas de órgãos ambientais' },
          { icon: 'tabler:message-circle', titulo: 'Suporte remoto contínuo', desc: 'Atendimento via WhatsApp e e-mail em horário comercial' },
          { icon: 'tabler:building-bank', titulo: 'Interface com órgãos e terceiros', desc: 'Quando aplicável ao escopo e à localidade' },
        ].map(({ icon, titulo, desc }) => (
          <div class="p-5 rounded-2xl border border-slate-100 bg-slate-50">
            <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center mb-3">
              <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
            </div>
            <h3 class="text-sm font-bold text-[#1a3044] mb-1">{titulo}</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona a Assessoria Ambiental Contínua</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">A empresa fornece informações e acesso. A Triaxis aplica método, rotina e organização.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Fase 1 -->
        <div>
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-8 rounded-full bg-[#3a8d44] flex items-center justify-center flex-shrink-0">
              <span class="text-white text-xs font-black">1</span>
            </div>
            <h3 class="text-white font-bold text-base">Fase 1: Setup (Implantação)</h3>
          </div>
          <div class="space-y-3">
            {[
              'Reunião inicial: objetivo, operação, histórico e prioridades',
              'Levantamento documental e diagnóstico do que existe e do que falta',
              'Matriz de obrigações: licenças, prazos, condicionantes e resíduos',
              'Plano de ação e cronograma com prioridades definidas',
              'Organização do dossiê ambiental com padrão de evidências',
            ].map((item, i) => (
              <div class="flex items-start gap-3 bg-white/10 rounded-xl p-4 border border-white/10">
                <span class="text-[#6fcf7f] font-black text-sm flex-shrink-0">{i + 1}.</span>
                <p class="text-slate-300 text-sm">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Fase 2 -->
        <div>
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-8 rounded-full bg-orange-500 flex items-center justify-center flex-shrink-0">
              <span class="text-white text-xs font-black">2</span>
            </div>
            <h3 class="text-white font-bold text-base">Fase 2: Rotina (Recorrência)</h3>
          </div>
          <div class="space-y-3">
            {[
              'Check-in periódico mensal ou bimestral conforme plano',
              'Atualização de prazos e pendências com registro de evidências',
              'Relatório do período com resumo e próximos passos',
              'Suporte contínuo para fiscalizações, dúvidas e adequações',
            ].map((item, i) => (
              <div class="flex items-start gap-3 bg-white/10 rounded-xl p-4 border border-white/10">
                <span class="text-orange-400 font-black text-sm flex-shrink-0">{i + 6}.</span>
                <p class="text-slate-300 text-sm">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PLANOS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Planos</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Planos de Assessoria Ambiental Contínua</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Contratos de 3, 6 ou 12 meses. O objetivo é o mesmo: conformidade com previsibilidade.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            plano: 'Essencial',
            tipo: 'Remoto',
            desc: 'Para empresas com operação estável e necessidade de organização e controle de prazos.',
            items: [
              'Setup inicial + diagnóstico',
              'Check-ins remotos periódicos',
              'Controle de prazos e condicionantes',
              'Relatório periódico',
              'Suporte técnico remoto em horário comercial',
            ],
            obs: 'Visita presencial não inclusa. Pode ser contratada separadamente quando necessário.',
            destaque: false,
          },
          {
            plano: 'Padrão',
            tipo: 'Híbrido sob demanda',
            desc: 'Para operações com rotina de resíduos e necessidade de evidências em campo.',
            items: [
              'Tudo do plano Essencial',
              'Visita presencial quando necessária para execução do serviço',
              'Indicado para empresas com movimentação de resíduos e exigências de campo',
            ],
            obs: 'Visitas presenciais dependem de agenda, localidade e necessidade técnica.',
            destaque: true,
          },
          {
            plano: 'Premium',
            tipo: 'Híbrido com mais presença',
            desc: 'Para empresas com maior volume, risco elevado, múltiplas frentes ou histórico de fiscalização.',
            items: [
              'Tudo do plano Padrão',
              'Maior disponibilidade de agenda',
              'Acompanhamento mais próximo e frequente',
              'Indicado para empresas com várias frentes ou histórico de fiscalização',
            ],
            obs: 'Recomendado para operações de maior porte ou com passivos ambientais ativos.',
            destaque: false,
          },
        ].map(({ plano, tipo, desc, items, obs, destaque }) => (
          <div class={`rounded-2xl p-7 border ${destaque ? 'border-[#3a8d44] bg-green-50 ring-2 ring-[#3a8d44]/20' : 'border-slate-100 bg-slate-50'}`}>
            {destaque && <span class="inline-block text-xs font-bold text-[#3a8d44] uppercase tracking-wider bg-green-100 px-3 py-1 rounded-full mb-4">Mais escolhido</span>}
            <h3 class="text-lg font-black text-[#1a3044] mb-1">{plano}</h3>
            <p class="text-xs text-[#3a8d44] font-bold uppercase tracking-wider mb-3">{tipo}</p>
            <p class="text-xs text-slate-500 mb-5">{desc}</p>
            <div class="space-y-2 mb-5">
              {items.map(item => (
                <div class="flex items-start gap-2">
                  <Icon name="tabler:check" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
                  <p class="text-xs text-slate-600">{item}</p>
                </div>
              ))}
            </div>
            <p class="text-xs text-slate-400 italic border-t border-slate-200 pt-4">{obs}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-slate-400 mt-6">Contratos disponíveis em 3, 6 ou 12 meses. Recomendado 6 meses ou mais para consolidar rotina.</p>
      <div class="flex justify-center mt-6">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20ajuda%20para%20escolher%20o%20plano%20(Essencial%2FPadrão%2FPremium)%20e%20o%20prazo%20(3%2F6%2F12%20meses).%20Minha%20cidade%20é%20____%20e%20meu%20segmento%20é%20____."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Me ajudar a escolher o plano
        </a>
      </div>
    </div>
  </section>

  <!-- PRAZOS + O QUE NÃO INCLUI (lado a lado) -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">

      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazos típicos do setup</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 text-sm mb-5">A assessoria é contínua. O setup inicial costuma ser rápido; a maturidade vem com a rotina.</p>
        <div class="space-y-3">
          {[
            { prazo: '7 a 15 dias', desc: 'Setup simples: documentação básica disponível e operação sem passivos relevantes' },
            { prazo: '15 a 30 dias', desc: 'Setup médio: documentação parcial, licenças com pendências e organização inicial necessária' },
            { prazo: 'Acima de 30 dias', desc: 'Casos complexos: passivos antigos, dependência de órgãos, análises laboratoriais ou terceiros' },
          ].map(({ prazo, desc }) => (
            <div class="bg-white rounded-xl p-4 border border-slate-100">
              <p class="text-sm font-bold text-[#1a3044] mb-1">{prazo}</p>
              <p class="text-xs text-slate-500">{desc}</p>
            </div>
          ))}
        </div>
        <p class="text-xs text-slate-400 mt-4 italic">Pode atrasar se houver falta de documentos, licença vencida há muito tempo, dependência de análises laboratoriais ou exigências do órgão ambiental local.</p>
      </div>

      <div>
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Transparência</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">O que não está incluso</h2>
        <div class="w-12 h-1 bg-orange-500 rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            'Taxas e emolumentos de órgãos ambientais',
            'Análises laboratoriais e monitoramentos externos',
            'Obras, adequações físicas e projetos executivos',
            'Transporte e destinação de resíduos e contratos com destinadores',
            'Custos de sistemas e cadastros exigidos por órgão ou terceiros',
            'ART e RRT de terceiros e serviços fora do escopo contratado',
            'Multas e penalidades aplicadas por órgãos ambientais',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-3 border border-slate-100">
              <Icon name="tabler:x" class="w-4 h-4 text-slate-300 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-500">{item}</p>
            </div>
          ))}
        </div>
      </div>

