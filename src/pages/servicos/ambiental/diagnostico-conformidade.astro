---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Diagnóstico de Conformidade Ambiental | Triaxis Consultoria',
  description: 'Diagnóstico técnico de conformidade ambiental para empresas em Minas Gerais. Levantamento de pendências, matriz de riscos e plano de ação 90 dias. Entrega em até 7 dias. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Diagnóstico de Conformidade</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Diagnóstico de Conformidade Ambiental
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Levantamento técnico completo da situação ambiental da empresa: pendências, riscos e prioridades identificadas com um plano claro de ação para regularização.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-8">
        {[
          'Levantamento de documentos e obrigações aplicáveis',
          'Matriz de riscos com prioridades e impactos',
          'Plano de ação 90 dias para regularização',
          'Entrega em até 7 dias',
        ].map(item => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/20">
            <Icon name="tabler:check" class="w-3.5 h-3.5 text-[#6fcf7f]" />
            {item}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20agendar%20um%20Diagnóstico%20de%20Conformidade%20Ambiental."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Agendar diagnóstico
        </a>
        <a href="#como-funciona"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Como funciona
        </a>
      </div>
    </div>
  </section>

  <!-- O QUE É -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Definição</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é o Diagnóstico de Conformidade Ambiental</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          O Diagnóstico de Conformidade é um levantamento técnico estruturado que mapeia a situação real da empresa frente às exigências legais ambientais vigentes. Funciona como um raio-X ambiental: identifica o que está regularizado, o que está pendente e o que representa risco imediato.
        </p>
        <p class="text-slate-600 leading-relaxed">
          O resultado é um relatório objetivo com a situação de cada obrigação, a classificação por grau de risco e um plano de ação com prioridades e prazos definidos para regularização em 90 dias.
        </p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">O diagnóstico avalia</p>
        <div class="space-y-4">
          {[
            { icon: 'tabler:license', label: 'Licenças ambientais', desc: 'Validade, condicionantes, pendências e histórico junto aos órgãos competentes' },
            { icon: 'tabler:droplet', label: 'Outorgas de uso de água', desc: 'Captação e lançamento de efluentes conforme legislação aplicável' },
            { icon: 'tabler:trash', label: 'Gestão de resíduos', desc: 'Classificação, destinação, documentação e rastreabilidade via MTR' },
            { icon: 'tabler:file-report', label: 'Obrigações acessórias', desc: 'Relatórios, cadastros e declarações periódicas exigidas pelo órgão licenciador' },
          ].map(({ icon, label, desc }) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <div>
                <p class="text-sm font-bold text-[#1a3044]">{label}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-funciona" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Processo</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona o diagnóstico</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Cinco entregáveis definidos. Prazo de até 7 dias após o recebimento dos documentos.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          {
            num: '01',
            titulo: 'Reunião técnica inicial',
            desc: 'Conversa de até 60 minutos (online) para entendimento da atividade, histórico ambiental da empresa e prioridades da gestão.',
          },
          {
            num: '02',
            titulo: 'Checklist documental',
            desc: 'Levantamento completo do que a empresa possui e do que está faltando: licenças, outorgas, registros, relatórios e condicionantes.',
          },
          {
            num: '03',
            titulo: 'Mapa de riscos e prioridades',
            desc: 'Classificação de cada obrigação ambiental por grau de criticidade: alto, médio ou baixo, com justificativa técnica para cada classificação.',
          },
          {
            num: '04',
            titulo: 'Plano de ação 90 dias',
            desc: 'Sequência de regularização definida por prioridade, com o que fazer primeiro, por quê e como, de forma objetiva e aplicável.',
          },
          {
            num: '05',
            titulo: 'Orçamento em dois caminhos',
            desc: 'Apresentação das opções de execução: o caminho mínimo necessário para regularização e o caminho completo para conformidade ampla.',
          },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-7 border border-white/10">
            <span class="text-3xl font-black text-[#3a8d44] opacity-60 mb-3 block">{num}</span>
            <h3 class="text-white font-bold text-base mb-2">{titulo}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
        <div class="bg-orange-500/10 rounded-2xl p-7 border border-orange-400/20 flex items-center gap-4">
          <Icon name="tabler:clock" class="w-10 h-10 text-orange-400 flex-shrink-0" />
          <div>
            <p class="text-white font-bold text-base mb-1">Prazo de entrega</p>
            <p class="text-slate-300 text-sm">Até 7 dias corridos após o recebimento dos documentos solicitados.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUANDO É NECESSÁRIO -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Aplicações</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Quando o diagnóstico é necessário</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Situações em que a avaliação da conformidade ambiental é urgente ou estrategicamente relevante.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: 'tabler:building-factory', text: 'Empresa sem histórico organizado de licenças ou documentação ambiental' },
          { icon: 'tabler:alert-triangle', text: 'Recebimento de notificação, auto de infração ou autuação por órgão ambiental' },
          { icon: 'tabler:transfer', text: 'Processos de fusão, aquisição ou due diligence ambiental' },
          { icon: 'tabler:cash', text: 'Acesso a financiamentos ou certificações que exigem conformidade ambiental comprovada' },
          { icon: 'tabler:rotate', text: 'Mudança de atividade, ampliação ou reforma com impacto no passivo ambiental' },
          { icon: 'tabler:eye', text: 'Preparação para auditorias internas, externas ou visitas de órgãos fiscalizadores' },
        ].map(({ icon, text }) => (
          <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-slate-100 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <Icon name={icon} class="w-5 h-5 text-orange-500" />
            </div>
            <p class="text-sm text-slate-600 leading-snug">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFÍCIOS + DIFERENCIAIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Resultados</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Benefícios para a empresa</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:shield-check', text: 'Conhecimento real da situação ambiental antes de enfrentar fiscalizações ou auditorias' },
            { icon: 'tabler:zoom-money', text: 'Redução do risco de multas, embargos e interdições por irregularidades não identificadas' },
            { icon: 'tabler:chart-arrows-vertical', text: 'Base técnica para priorizar investimentos em conformidade de forma eficiente' },
            { icon: 'tabler:certificate', text: 'Documentação organizada para apresentação a financiadores, parceiros e órgãos reguladores' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Diferenciais</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Por que escolher a Triaxis</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:map-pin', text: 'Experiência em conformidade ambiental para empresas de diferentes portes e setores em Minas Gerais' },
            { icon: 'tabler:users', text: 'Equipe multidisciplinar com Engenheiros Ambientais, Biólogos e especialistas em legislação ambiental' },
            { icon: 'tabler:file-analytics', text: 'Relatório objetivo, com linguagem clara e plano de ação aplicável à realidade da empresa' },
            { icon: 'tabler:refresh', text: 'O valor do diagnóstico pode ser abatido na contratação da execução do plano de adequação' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#1a3044]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center tx-fade">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Saiba exatamente onde sua empresa está</p>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Agende o Diagnóstico de Conformidade Ambiental.
      </h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        A Triaxis realiza a avaliação completa da situação ambiental da empresa e entrega o relatório com mapa de riscos e plano de ação em até 7 dias.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20agendar%20um%20Diagnóstico%20de%20Conformidade%20Ambiental."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Agendar diagnóstico
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors">
          Enviar mensagem
        </a>
      </div>
    </div>
  </section>

  <Footer {...footerData} />
</Layout>
