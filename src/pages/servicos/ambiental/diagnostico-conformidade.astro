---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Diagnóstico de Conformidade Ambiental (Check-up) | Ouro Preto, Mariana e Belo Horizonte',
  description: 'Check-up ambiental para identificar pendências, riscos e prioridades. Entregáveis claros, plano de ação e devolutiva. Ouro Preto, Mariana, BH e região. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Diagnóstico de Conformidade</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Check-up de Conformidade Ambiental: identifique pendências e reduza risco de multa
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Diagnóstico técnico e objetivo para mapear riscos, não conformidades e prioridades ambientais da sua operação em Ouro Preto, Mariana, Belo Horizonte e região — antes que se tornem multa, embargo ou paralisação.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-8">
        {[
          'Diagnóstico claro da situação ambiental atual',
          'Não conformidades e riscos classificados: baixo, médio e alto',
          'Plano de ação priorizado: 0 a 30 a 90 dias',
          'Orientação sobre documentos e evidências para fiscalização',
        ].map(item => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/20">
            <Icon name="tabler:check" class="w-3.5 h-3.5 text-[#6fcf7f]" />
            {item}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20um%20Check-up%20de%20Conformidade%20Ambiental.%20Minha%20empresa%20é%20do%20setor%20____%20e%20fica%20em%20____.%20Podemos%20falar%20sobre%20escopo%2C%20prazo%20e%20proposta%3F"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Fazer check-up no WhatsApp
        </a>
        <a href="https://wa.me/5531994915126?text=Olá!%20Quero%20solicitar%20uma%20proposta%20para%20Diagnóstico%20de%20Conformidade%20Ambiental."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Solicitar proposta (24h)
        </a>
      </div>
    </div>
  </section>

  <!-- O QUE É -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Definição</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é o Diagnóstico de Conformidade Ambiental</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          O Diagnóstico de Conformidade Ambiental é um serviço pontual de consultoria que avalia se a empresa está atendendo às exigências ambientais aplicáveis à sua atividade e localidade: licenças, resíduos, documentos, evidências e rotinas. Ao final, a empresa recebe um retrato real da situação e um plano de ação para regularizar com prioridade e previsibilidade.
        </p>
        <p class="text-slate-600 leading-relaxed mb-6">
          Não se trata de licenciamento nem de auditoria certificadora. É um diagnóstico técnico para orientar decisões e evitar retrabalho, urgências e custos desnecessários.
        </p>
        <div class="space-y-3">
          {[
            'Avaliação técnica da situação atual: documental e operacional',
            'Identificação de não conformidades e riscos',
            'Mapa do que é obrigatório para a atividade e a localidade',
            'Base prática para regularização e planejamento',
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded-full bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon name="tabler:check" class="w-3 h-3 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600">{item}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">O diagnóstico avalia</p>
        <div class="space-y-4">
          {[
            { icon: 'tabler:license', label: 'Licenças e autorizações', desc: 'Validade, condicionantes e pendências junto aos órgãos competentes' },
            { icon: 'tabler:droplet', label: 'Outorgas de uso de água', desc: 'Captação, lançamento de efluentes e conformidade com a legislação' },
            { icon: 'tabler:trash', label: 'Gestão de resíduos', desc: 'Rotina, armazenamento, destinação, documentação e rastreabilidade' },
            { icon: 'tabler:file-report', label: 'Obrigações acessórias', desc: 'Relatórios, cadastros e declarações periódicas exigidas pelo órgão licenciador' },
          ].map(({ icon, label, desc }) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <div>
                <p class="text-sm font-bold text-[#1a3044]">{label}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PARA QUEM É -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Indicação</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Para quem o Diagnóstico de Conformidade é indicado</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Ideal para empresas que querem clareza antes de investir tempo e dinheiro sem diagnóstico prévio.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-4">Segmentos atendidos</p>
          <div class="space-y-3">
            {[
              { icon: 'tabler:car', text: 'Oficinas mecânicas, funilarias, auto centers e lava-jatos' },
              { icon: 'tabler:bulldozer', text: 'Construtoras, empreiteiras e prestadores de obra' },
              { icon: 'tabler:mountain', text: 'Terraplenagem e movimentação de solo' },
              { icon: 'tabler:building-factory', text: 'Pequenas indústrias, metalúrgicas e serralherias' },
              { icon: 'tabler:truck', text: 'Transportadoras e logística' },
              { icon: 'tabler:shovel', text: 'Prestadores de serviços para o setor de mineração' },
            ].map(({ icon, text }) => (
              <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-slate-100">
                <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                  <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
                </div>
                <p class="text-sm text-slate-600">{text}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-4">Situações que indicam necessidade</p>
          <div class="space-y-3">
            {[
              'Licença vencendo, vencida ou dúvida se está correta para a atividade',
              'Falta de organização de documentos e evidências ambientais',
              'Resíduos sem rotina definida e sem rastreabilidade',
              'Histórico de fiscalização, notificação ou auto de infração',
              'Antes de contratar assessoria contínua, para começar com diagnóstico real',
            ].map(item => (
              <div class="flex items-start gap-3 bg-white rounded-xl p-4 border border-l-4 border-l-orange-400 border-slate-100">
                <Icon name="tabler:alert-triangle" class="w-4 h-4 text-orange-400 flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que a empresa recebe no diagnóstico</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Entregáveis objetivos, focados na operação real da empresa e no que será efetivamente cobrado ou avaliado pelo órgão ambiental.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: 'tabler:stethoscope', titulo: 'Diagnóstico da situação atual', desc: 'Avaliação documental e operacional com base nas exigências legais aplicáveis' },
          { icon: 'tabler:list-check', titulo: 'Matriz de obrigações aplicáveis', desc: 'O que é obrigatório para a atividade e a localidade da empresa' },
          { icon: 'tabler:license', titulo: 'Verificação de licenças', desc: 'Análise de licenças e autorizações existentes, com avaliação de condicionantes' },
          { icon: 'tabler:trash', titulo: 'Avaliação da gestão de resíduos', desc: 'Rotina, armazenamento, destinação e evidências de rastreabilidade' },
          { icon: 'tabler:alert-triangle', titulo: 'Lista de não conformidades', desc: 'Classificação de riscos por impacto, urgência e exigência legal: baixo, médio e alto' },
          { icon: 'tabler:timeline', titulo: 'Plano de ação priorizado', desc: 'O que fazer em 0, 30 e 90 dias, com sequência técnica definida' },
          { icon: 'tabler:folder-open', titulo: 'Lista de evidências recomendadas', desc: 'Documentos e registros necessários para prontidão em fiscalização' },
          { icon: 'tabler:file-report', titulo: 'Relatório técnico', desc: 'Versão executiva e técnica do diagnóstico para tomada de decisão' },
          { icon: 'tabler:presentation', titulo: 'Reunião de devolutiva', desc: 'Apresentação dos resultados com orientações e próximos passos' },
        ].map(({ icon, titulo, desc }) => (
          <div class="p-5 rounded-2xl border border-slate-100 bg-slate-50">
            <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center mb-3">
              <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
            </div>
            <h3 class="text-sm font-bold text-[#1a3044] mb-1">{titulo}</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Processo</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona o Diagnóstico de Conformidade</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Processo direto, sem burocracia desnecessária. Pode ser remoto ou com visita presencial, conforme a operação.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          { num: '01', titulo: 'Alinhamento e escopo', desc: 'Definição da atividade, localidade e objetivo do diagnóstico.' },
          { num: '02', titulo: 'Checklist documental', desc: 'Solicitação de documentos e informações conforme o perfil da empresa.' },
          { num: '03', titulo: 'Análise documental', desc: 'Avaliação dos documentos recebidos frente aos requisitos legais aplicáveis.' },
          { num: '04', titulo: 'Avaliação da operação', desc: 'Análise remota e/ou presencial conforme a necessidade do caso.' },
          { num: '05', titulo: 'Identificação de não conformidades', desc: 'Levantamento de pendências e riscos com base na avaliação técnica.' },
          { num: '06', titulo: 'Priorização técnica', desc: 'Classificação das pendências por criticidade e sequência de regularização.' },
          { num: '07', titulo: 'Elaboração do relatório', desc: 'Redação do relatório técnico com todas as constatações e o plano de ação.' },
          { num: '08', titulo: 'Reunião de devolutiva', desc: 'Apresentação dos resultados com orientações claras sobre os próximos passos.' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-5 border border-white/10 flex gap-4">
            <span class="text-2xl font-black text-[#3a8d44] opacity-50 flex-shrink-0 leading-none">{num}</span>
            <div>
              <h3 class="text-white font-bold text-sm mb-1">{titulo}</h3>
              <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-6 bg-orange-500/10 rounded-2xl p-6 border border-orange-400/20 flex items-center gap-4">
        <Icon name="tabler:clock" class="w-10 h-10 text-orange-400 flex-shrink-0" />
        <div>
          <p class="text-white font-bold text-sm mb-1">Prazo de entrega</p>
          <p class="text-slate-300 text-sm">Simples: 5 a 7 dias. Médio: 7 a 15 dias. Complexo: até 30 dias. Contados após o recebimento dos documentos solicitados.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRAZOS + O QUE NÃO INCLUI -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">

      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazos típicos do diagnóstico</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-3 mb-4">
          {[
            { prazo: '5 a 7 dias', desc: 'Operação simples, documentação disponível e sem passivos relevantes' },
            { prazo: '7 a 15 dias', desc: 'Porte médio, documentação parcial ou pendências de organização inicial' },
            { prazo: 'Até 30 dias', desc: 'Casos complexos: múltiplas frentes, passivos antigos ou dependência de terceiros' },
          ].map(({ prazo, desc }) => (
            <div class="bg-white rounded-xl p-4 border border-slate-100">
              <p class="text-sm font-bold text-[#1a3044] mb-1">{prazo}</p>
              <p class="text-xs text-slate-500">{desc}</p>
            </div>
          ))}
        </div>
        <p class="text-xs text-slate-400 italic">Pode exigir prazo maior quando houver falta de documentos, passivos antigos, dependência de destinadores ou laboratório, ou operação com múltiplas frentes.</p>
      </div>

      <div>
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Transparência</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">O que não está incluso</h2>
        <div class="w-12 h-1 bg-orange-500 rounded-full mb-6"></div>
        <div class="space-y-3">
          {[
            'Taxas e emolumentos de órgãos ambientais',
            'Análises laboratoriais, monitoramentos e campanhas de amostragem',
            'Elaboração de projetos específicos (PGRS completo, PRAD, PCA) — podem ser contratados separadamente',
            'Adequações físicas, obras ou reformas',
            'Transporte e destinação de resíduos',
            'ART e RRT de terceiros quando exigidos por escopo específico',
            'Multas e penalidades aplicadas por órgãos ambientais',
            'Cadastros em sistemas do órgão ambiental — podem ser incluídos como serviço adicional',
          ].map(item => (
            <div class="flex items-start gap-3 bg-white rounded-xl p-3 border border-slate-100">
              <Icon name="tabler:x" class="w-4 h-4 text-slate-300 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-500">{item}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- POR QUE TRIAXIS + AUTOAVALIAÇÃO -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Diferenciais</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Por que confiar na Triaxis</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 text-sm mb-5">Diagnóstico prático, direto e aplicável — com relatório para tomada de decisão, não para ficar na gaveta.</p>
        <div class="space-y-4">
          {[
            { icon: 'tabler:list-check', text: 'Metodologia com checklist, matriz de obrigações e classificação de risco por criticidade' },
            { icon: 'tabler:file-analytics', text: 'Relatório objetivo em versão executiva e técnica, para uso real na gestão da empresa' },
            { icon: 'tabler:message-circle', text: 'Comunicação direta e transparente em todas as etapas do processo' },
            { icon: 'tabler:map-pin', text: 'Atuação local em Ouro Preto, Mariana e Belo Horizonte, com atendimento remoto em Minas Gerais' },
            { icon: 'tabler:shield-check', text: 'Integração com Segurança do Trabalho quando necessário ao escopo definido' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-2">Autoavaliação</p>
        <h3 class="text-lg font-bold text-[#1a3044] mb-5">Sua empresa está em conformidade ambiental?</h3>
        <div class="space-y-3 mb-5">
          {[
            'Sei quais licenças preciso manter e se as atuais estão corretas?',
            'Tenho controle de prazos e condicionantes?',
            'Os resíduos têm rotina definida de armazenamento, coleta, destinação e evidências?',
            'Os documentos e evidências estão organizados para fiscalização?',
            'Já houve fiscalização ou existe risco de ocorrer?',
            'A operação está em Minas Gerais?',
            'Quero evitar urgências, multas e interrupções na operação?',
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-5 h-5 rounded border-2 border-slate-300 flex-shrink-0 mt-0.5"></div>
              <p class="text-sm text-slate-600">{item}</p>
            </div>
          ))}
        </div>
        <a href="https://wa.me/5531994915126?text=Olá!%20Respondi%20o%20checklist%20e%20quero%20um%20Check-up%20de%20Conformidade%20Ambiental."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-6 py-3 rounded-full text-sm transition-colors w-full justify-center">
          <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
          Fazer check-up no WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-3xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Dúvidas</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Perguntas frequentes</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full"></div>
      </div>
      <div class="space-y-4">
        {[
          {
            p: 'Vocês atendem minha cidade?',
            r: 'Sim. O atendimento presencial é realizado nas regiões de Ouro Preto, Mariana e Belo Horizonte, conforme combinação prévia. O diagnóstico remoto cobre todo o estado de Minas Gerais, conforme a viabilidade do caso.',
          },
          {
            p: 'É possível fazer o diagnóstico de forma remota?',
            r: 'Sim. Parte ou todo o diagnóstico pode ser conduzido remotamente. Para operações com áreas externas, armazenamento de resíduos, obras e movimentação de solo, a visita presencial costuma ser recomendada para maior precisão técnica.',
