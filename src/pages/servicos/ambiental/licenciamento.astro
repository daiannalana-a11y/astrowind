---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Licenciamento e Regularização Ambiental | Triaxis Consultoria',
  description: 'Licenciamento ambiental em Minas Gerais com planejamento técnico, acompanhamento junto aos órgãos competentes e suporte contínuo. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Licenciamento Ambiental</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Licenciamento e Regularização Ambiental
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Segurança jurídica e conformidade ambiental para sua empresa. Planejamento técnico, organização documental e acompanhamento junto aos órgãos competentes em cada etapa do processo.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20solicitar%20uma%20proposta%20para%20Licenciamento%20Ambiental."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Solicitar proposta
        </a>
        <a href="#como-atuamos"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Como funciona
        </a>
      </div>
    </div>
  </section>

  <!-- INTRODUÇÃO -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Contexto</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">Por que o licenciamento exige atenção técnica</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          O licenciamento ambiental é um dos processos mais exigentes da gestão empresarial. Envolve múltiplos órgãos, prazos específicos, documentação técnica e atendimento a condicionantes que variam conforme a atividade e a localidade.
        </p>
        <p class="text-slate-600 leading-relaxed">
          A Triaxis conduz o processo com planejamento técnico, organização documental e acompanhamento direto junto aos órgãos competentes, reduzindo o risco de negativas, inconsistências e atrasos desnecessários.
        </p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">Tipos de licença que atendemos</p>
        <div class="space-y-4">
          {[
            { sigla: 'LP', nome: 'Licença Prévia', desc: 'Aprovação da viabilidade e localização do empreendimento' },
            { sigla: 'LI', nome: 'Licença de Instalação', desc: 'Autorização para implantação conforme projeto aprovado' },
            { sigla: 'LO', nome: 'Licença de Operação', desc: 'Autorização para início e continuidade das atividades' },
            { sigla: 'LR', nome: 'Renovação de Licença', desc: 'Manutenção da regularidade antes do vencimento' },
          ].map(({ sigla, nome, desc }) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
                <span class="text-xs font-black text-[#3a8d44]">{sigla}</span>
              </div>
              <div>
                <p class="text-sm font-bold text-[#1a3044]">{nome}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- DESAFIOS -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Atenção</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Principais dificuldades no processo</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Problemas recorrentes que comprometem a regularidade ambiental das empresas.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: 'tabler:file-unknown', text: 'Falta de clareza sobre as exigências legais e documentais aplicáveis à atividade' },
          { icon: 'tabler:clock-x', text: 'Processos negados ou com prazo comprometido por inconsistências técnicas' },
          { icon: 'tabler:building-bank', text: 'Dificuldade de interlocução com órgãos ambientais estaduais e municipais' },
          { icon: 'tabler:license-off', text: 'Licenças vencidas ou em atraso, expondo a empresa a riscos de autuação' },
          { icon: 'tabler:shield-x', text: 'Risco de multas, interdições ou embargos por irregularidade ambiental' },
        ].map(({ icon, text }) => (
          <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-slate-100 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <Icon name={icon} class="w-5 h-5 text-orange-500" />
            </div>
            <p class="text-sm text-slate-600 leading-snug">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO ATUAMOS -->
  <section id="como-atuamos" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como a Triaxis atua</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Cada etapa é conduzida com planejamento técnico, transparência e acompanhamento direto junto aos órgãos.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          {
            num: '01',
            titulo: 'Diagnóstico técnico detalhado',
            desc: 'Levantamento completo da situação ambiental da empresa: atividade, porte, localização, histórico de licenças e obrigações aplicáveis.',
          },
          {
            num: '02',
            titulo: 'Elaboração e organização documental',
            desc: 'Montagem do processo com toda a base legal e técnica exigida pelo órgão competente, reduzindo o risco de pendências e exigências complementares.',
          },
          {
            num: '03',
            titulo: 'Acompanhamento junto aos órgãos',
            desc: 'Gestão direta do processo de licenciamento perante SUPRAM, SEMAD, prefeituras e demais órgãos, com comunicação técnica formal em cada etapa.',
          },
          {
            num: '04',
            titulo: 'Atualização e renovação periódica',
            desc: 'Monitoramento dos prazos de vencimento para manter a empresa regularizada, com antecedência suficiente para evitar lapsos de conformidade.',
          },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-7 border border-white/10">
            <span class="text-3xl font-black text-[#3a8d44] opacity-60 mb-3 block">{num}</span>
            <h3 class="text-white font-bold text-base mb-2">{titulo}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFÍCIOS + DIFERENCIAIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 tx-fade">

      <!-- Benefícios -->
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Resultados</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Benefícios para a empresa</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:shield-check', text: 'Redução de riscos legais e financeiros associados à irregularidade ambiental' },
            { icon: 'tabler:rocket', text: 'Processos conduzidos com agilidade e aprovados com base técnica sólida' },
            { icon: 'tabler:scale', text: 'Segurança perante órgãos fiscalizadores e auditorias externas' },
            { icon: 'tabler:star', text: 'Credibilidade ambiental perante clientes, parceiros e financiadores' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Por que Triaxis -->
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Diferenciais</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Por que escolher a Triaxis</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:certificate', text: 'Experiência consolidada em licenciamento industrial e corporativo em Minas Gerais' },
            { icon: 'tabler:users', text: 'Equipe técnica com Engenheiros Ambientais, Biólogos e Técnicos em Meio Ambiente' },
            { icon: 'tabler:handshake', text: 'Relacionamento direto e ético com órgãos públicos estaduais e municipais' },
            { icon: 'tabler:refresh', text: 'Suporte contínuo após a emissão das licenças, com controle de prazos e condicionantes' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#1a3044]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center tx-fade">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Regularize sua empresa</p>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Inicie o processo de licenciamento com suporte técnico especializado.
      </h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        A Triaxis avalia a situação atual da empresa, identifica as licenças necessárias e apresenta um plano de ação com prazos e etapas definidas.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20uma%20proposta%20para%20Licenciamento%20Ambiental."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Falar com especialista
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors">
          Enviar mensagem
        </a>
      </div>
    </div>
  </section>

  <Footer {...footerData} />
</Layout>
