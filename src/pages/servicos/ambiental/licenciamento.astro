---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Licenciamento Ambiental em MG (Regularização e Renovação) | Ouro Preto, Mariana e BH',
  description: 'Regularize ou renove o licenciamento ambiental da sua empresa em Minas Gerais. Checklist, cronograma e acompanhamento claro do diagnóstico ao protocolo. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Licenciamento Ambiental</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Licenciamento Ambiental em MG<br class="hidden md:block" />
        <span class="text-[#6fcf7f]">(Regularização e Renovação)</span>
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-4 max-w-2xl mx-auto">
        Regularize sua empresa e evite dor de cabeça com fiscalização, embargo e prazos estourando.
        A Triaxis cuida do seu Licenciamento Ambiental com organização, clareza e foco em conformidade.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        {[
          { icon: 'tabler:map-pin', text: 'Presencial até 300 km (base: Ouro Preto/MG) e remoto' },
          { icon: 'tabler:checklist', text: 'Checklists + comunicação periódica do andamento' },
          { icon: 'tabler:building-factory', text: 'Integração com segurança do trabalho e visão de processos' },
        ].map(({ icon, text }) => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/10">
            <Icon name={icon} class="w-4 h-4 text-[#6fcf7f]" />
            {text}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20licenciamento%20ambiental%20(regulariza%C3%A7%C3%A3o/renova%C3%A7%C3%A3o)%20em%20MG.%20Minha%20empresa%20%C3%A9%20de%20[SEGMENTO]%20em%20[CIDADE]."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Falar no WhatsApp e avaliar meu caso
        </a>
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Pode%20me%20passar%20um%20or%C3%A7amento%20para%20licenciamento%20ambiental%20em%20[CIDADE]%3F%20Tenho%20CNPJ%20e%20a%20atividade%20%C3%A9%20[ATIVIDADE]."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Pedir orçamento rápido
        </a>
      </div>
    </div>
  </section>

  <!-- O QUE É LICENCIAMENTO -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entenda o processo</p>
          <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é licenciamento ambiental e por que sua empresa precisa?</h2>
          <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
          <p class="text-slate-600 leading-relaxed mb-4">
            Licenciamento ambiental é o processo que autoriza a localização, instalação e/ou operação de atividades que possam gerar impacto ambiental.
          </p>
          <p class="text-slate-600 leading-relaxed mb-6">
            Na prática: é a licença (ou regularização) que comprova que sua empresa está em conformidade com o órgão ambiental e com as regras aplicáveis ao seu porte, atividade e localidade.
          </p>
          <div class="space-y-3 mb-8">
            {[
              { icon: 'tabler:file-check', label: 'Regularização', desc: 'quando a empresa ainda não tem licença válida ou mudou atividade/endereço' },
              { icon: 'tabler:refresh', label: 'Renovação', desc: 'quando a licença vai vencer e precisa ser renovada dentro do prazo' },
              { icon: 'tabler:file-text', label: 'Processo', desc: 'pode envolver documentos, formulários, estudos e resposta a exigências do órgão' },
            ].map(({ icon, label, desc }) => (
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
                </div>
                <p class="text-sm text-slate-600 leading-relaxed"><span class="font-semibold text-[#1a3044]">{label}:</span> {desc}</p>
              </div>
            ))}
          </div>
          <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Voc%C3%AA%20pode%20confirmar%20se%20minha%20atividade%20precisa%20de%20licen%C3%A7a%20ambiental%3F%20Sou%20de%20[CIDADE]%20e%20fa%C3%A7o%20[ATIVIDADE]."
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-6 py-3 rounded-full transition-colors text-sm shadow-md">
            <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
            Ver se minha atividade precisa de licença
          </a>
        </div>
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
          <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">Tipos de licença que atendemos</p>
          <div class="space-y-5">
            {[
              { sigla: 'LP', nome: 'Licença Prévia', desc: 'Aprovação da viabilidade e localização do empreendimento na fase de planejamento' },
              { sigla: 'LI', nome: 'Licença de Instalação', desc: 'Autorização para implantação conforme projeto e condicionantes aprovados' },
              { sigla: 'LO', nome: 'Licença de Operação', desc: 'Autorização para início e continuidade das atividades com controles exigidos' },
              { sigla: 'LR', nome: 'Renovação de Licença', desc: 'Manutenção da regularidade com protocolo antecipado ao vencimento' },
            ].map(({ sigla, nome, desc }) => (
              <div class="flex items-start gap-4">
                <div class="w-11 h-11 rounded-xl bg-[#1a3044] flex items-center justify-center flex-shrink-0">
                  <span class="text-xs font-black text-[#6fcf7f]">{sigla}</span>
                </div>
                <div>
                  <p class="text-sm font-bold text-[#1a3044]">{nome}</p>
                  <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PARA QUEM É -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Público-alvo</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Para quem é este serviço (e quando faz sentido agir agora)</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 max-w-2xl mx-auto text-sm leading-relaxed">
          Este serviço é para empresas que precisam iniciar, regularizar ou manter a operação sem surpresas com órgão ambiental e fiscalização.
          Ideal para quem quer previsibilidade de prazos, documentação organizada e suporte para responder exigências.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div class="bg-white rounded-2xl p-7 border border-slate-100 shadow-sm">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center">
              <Icon name="tabler:building-factory-2" class="w-5 h-5 text-[#3a8d44]" />
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm uppercase tracking-wide">Segmentos que mais atendemos</h3>
          </div>
          <div class="space-y-3">
            {[
              'Oficinas mecânicas, funilarias, auto centers e lava-jatos',
              'Construtoras, empreiteiras, terraplenagem e prestadores de obra',
              'Pequenas indústrias, metalúrgicas, serralherias e logística/transportadoras',
              'Prestadores de serviços para mineração (Ouro Preto, Mariana, Itabirito e entorno)',
            ].map((item) => (
              <div class="flex items-start gap-3">
                <Icon name="tabler:circle-check-filled" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600 leading-snug">{item}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-slate-100 shadow-sm">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center">
              <Icon name="tabler:alert-triangle" class="w-5 h-5 text-orange-500" />
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm uppercase tracking-wide">Situações comuns</h3>
          </div>
          <div class="space-y-3">
            {[
              'Licença vencendo nos próximos meses',
              'Empresa crescendo e "a documentação ficou para depois"',
              'Mudança de endereço, ampliação, novos equipamentos ou aumento de produção',
              'Exigência de cliente ou contrato pedindo regularidade ambiental',
            ].map((item) => (
              <div class="flex items-start gap-3">
                <Icon name="tabler:point-filled" class="w-4 h-4 text-orange-500 flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600 leading-snug">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20regularizar%20ou%20renovar%20minha%20licen%C3%A7a%20ambiental.%20Minha%20empresa%20%C3%A9%20de%20[SEGMENTO]%20em%20[CIDADE]."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Quero regularizar/renovar sem correria
        </a>
      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que você recebe ao contratar a Triaxis</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 max-w-xl mx-auto text-sm">
          Entrega completa, organizada e documentada do diagnóstico ao protocolo e acompanhamento.
          Tudo em linguagem simples, com registro do que foi feito e do que falta.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        {[
          { n: '01', text: 'Diagnóstico de enquadramento (atividade, porte e potencial poluidor) e definição do caminho de licenciamento' },
          { n: '02', text: 'Checklist de documentos e requisitos específicos do caso' },
          { n: '03', text: 'Plano de ação com prazos e responsabilidades (o que é do cliente vs. consultoria)' },
          { n: '04', text: 'Levantamento documental e organização do dossiê digital (pastas padronizadas)' },
          { n: '05', text: 'Preenchimento de formulários e preparação do processo para protocolo no sistema do órgão' },
          { n: '06', text: 'Memorial descritivo/relatório técnico de suporte (quando aplicável ao caso)' },
          { n: '07', text: 'Orientações de conformidade operacional (rotina, registros, evidências e boas práticas)' },
          { n: '08', text: 'Protocolo do processo e comprovantes (número do processo, recibos, prints quando necessário)' },
          { n: '09', text: 'Acompanhamento de análise e gestão de pendências/exigências técnicas dentro do escopo' },
          { n: '10', text: 'Entrega final com "kit do licenciamento": licença emitida + resumo executivo + recomendações de manutenção' },
        ].map(({ n, text }) => (
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-[#1a3044] flex items-center justify-center flex-shrink-0">
              <span class="text-xs font-black text-[#6fcf7f]">{n}</span>
            </div>
            <p class="text-sm text-slate-600 leading-snug">{text}</p>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20entender%20os%20entreg%C3%A1veis%20do%20licenciamento%20ambiental%20para%20minha%20empresa%20em%20[CIDADE].%20Atividade%3A%20[ATIVIDADE]."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Quero ver os entregáveis no meu caso
        </a>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-atuamos" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona (passo a passo)</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm max-w-xl mx-auto">
          Primeiro enquadrar corretamente, depois montar um processo consistente, protocolar e acompanhar ate a emissão.
          Sem improviso. Sem achismo. Com comunicação clara.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-10">
        {[
          { num: '01', titulo: 'Reunião inicial', desc: '15 a 40 min para entender atividade, local, histórico e urgência' },
          { num: '02', titulo: 'Enquadramento', desc: 'Definição do tipo de processo: regularização, renovação ou alteração' },
          { num: '03', titulo: 'Levantamento documental', desc: 'Solicitação e organização de documentos e informações do cliente' },
          { num: '04', titulo: 'Visita técnica', desc: 'Quando necessária: registros fotográficos e levantamentos básicos in loco' },
          { num: '05', titulo: 'Montagem do dossiê', desc: 'Preparação dos anexos técnicos e preenchimento de formulários' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-5 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-10">
        {[
          { num: '06', titulo: 'Revisão final', desc: 'Checklist de conformidade para reduzir exigências do órgão' },
          { num: '07', titulo: 'Protocolo', desc: 'Envio no sistema do órgão estadual/municipal e geração de comprovantes' },
          { num: '08', titulo: 'Acompanhamento', desc: 'Gestão de prazos e resposta a exigências dentro do escopo contratado' },
          { num: '09', titulo: 'Emissão da licença', desc: 'Recebimento do ato/licença e entrega do "kit do licenciamento"' },
          { num: '10', titulo: 'Orientação de manutenção', desc: 'Condicionantes, prazos de renovação e rotina de evidências' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-5 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20come%C3%A7ar%20pelo%20enquadramento%20do%20licenciamento%20ambiental.%20Empresa%20em%20[CIDADE]%20-%20atividade%3A%20[ATIVIDADE]."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Quero começar pelo enquadramento
        </a>
      </div>
    </div>
  </section>

  <!-- PRAZOS + CHECKLIST DO CLIENTE -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">

      <!-- Prazos -->
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazos típicos (e o que pode variar)</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
        <p class="text-slate-600 text-sm leading-relaxed mb-5">
          O prazo depende do tipo de licença, do órgão competente e da qualidade da documentação.
          A Triaxis controla o que está ao alcance da consultoria: organização, velocidade de resposta e protocolo correto.
        </p>
        <div class="space-y-3 mb-5">
          {[
            { prazo: 'Casos simples', tempo: '15 a 45 dias para preparar e protocolar + análise do órgão' },
            { prazo: 'Casos médios', tempo: '30 a 75 dias para preparar e protocolar + análise do órgão' },
            { prazo: 'Casos complexos', tempo: '60 a 120+ dias (podem exigir estudos/plantas/adequações) + análise do órgão' },
          ].map(({ prazo, tempo }) => (
            <div class="flex items-start gap-3 p-4 bg-slate-50 rounded-xl border border-slate-100">
              <Icon name="tabler:clock" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
              <div>
                <span class="text-xs font-bold text-[#1a3044] block">{prazo}</span>
                <span class="text-xs text-slate-500">{tempo}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 mb-5">
          <p class="text-xs text-orange-700 font-semibold mb-1">O que mais atrasa:</p>
          <p class="text-xs text-orange-600 leading-relaxed">
            Falta de documentos, dados inconsistentes, pendências cadastrais, exigências técnicas, agenda de vistoria, pagamentos de taxas e mudanças de entendimento do órgão.
          </p>
        </div>
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Tenho%20prazo%20at%C3%A9%20[DATA]%20para%20regularizar/renovar.%20Empresa%20em%20[CIDADE]%20-%20atividade%3A%20[ATIVIDADE].%20D%C3%A1%20tempo%3F"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-5 py-3 rounded-full transition-colors text-sm shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
          Tenho prazo — dá tempo?
        </a>
      </div>

      <!-- Checklist do cliente -->
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Documentação</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">O que preciso de você (para andar rápido)</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
        <p class="text-slate-600 text-sm leading-relaxed mb-5">
          Licenciamento é um trabalho em equipe. Você entra com informações e documentos; a Triaxis entra com método, técnica e gestão do processo.
          Quanto mais completo o checklist, menos exigências e retrabalho.
        </p>
        <div class="space-y-2 mb-5">
          {[
            'CNPJ, contrato social/alterações e dados do responsável legal',
            'Endereço completo, inscrição municipal/estadual (se houver) e alvará (se existir)',
            'Descrição da atividade, capacidade/produção, horários e número de funcionários',
            'Layout/fotos do local (planta, se disponível)',
