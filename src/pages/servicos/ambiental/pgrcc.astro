---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Plano de Gerenciamento de Resíduos da Construção Civil (PGRCC) | Triaxis Consultoria',
  description: 'Elaboração do PGRCC para obras e construtoras em Minas Gerais. Conformidade com a Resolução CONAMA 307 e legislação municipal. Classificação, destinação e rastreabilidade de RCC. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">PGRCC</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Plano de Gerenciamento de Resíduos da Construção Civil
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Elaboração técnica do PGRCC conforme a Resolução CONAMA 307/2002 e legislações municipais. Viabiliza a aprovação de projetos, a obtenção do alvará de construção e a regularidade ambiental da obra.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20solicitar%20uma%20proposta%20para%20elaboração%20de%20PGRCC."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Solicitar proposta
        </a>
        <a href="#como-atuamos"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Como funciona
        </a>
      </div>
    </div>
  </section>

  <!-- INTRODUÇÃO -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Contexto</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é o PGRCC e quando é exigido</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          O Plano de Gerenciamento de Resíduos da Construção Civil é o documento técnico que estabelece como os resíduos gerados em obras serão segregados, acondicionados, transportados e destinados. É exigido como condição para aprovação de projetos e emissão de alvarás de construção na maioria dos municípios de Minas Gerais.
        </p>
        <p class="text-slate-600 leading-relaxed">
          A base legal principal é a Resolução CONAMA 307/2002, complementada pelas legislações estaduais e municipais. A Triaxis elabora o PGRCC com base nas características reais da obra, nos volumes estimados de RCC e nas exigências específicas do município onde a construção será executada.
        </p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">Classificação dos resíduos da construção</p>
        <div class="space-y-4">
          {[
            { sigla: 'A', nome: 'Classe A', desc: 'Reutilizáveis ou recicláveis como agregados: concreto, tijolos, blocos, telhas, argamassa' },
            { sigla: 'B', nome: 'Classe B', desc: 'Recicláveis para outros destinos: plásticos, papel, metais, vidros, madeiras' },
            { sigla: 'C', nome: 'Classe C', desc: 'Sem tecnologia economicamente viável de reciclagem: produtos gessados' },
            { sigla: 'D', nome: 'Classe D', desc: 'Perigosos: tintas, solventes, óleos, amianto e resíduos contaminados' },
          ].map(({ sigla, nome, desc }) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
                <span class="text-xs font-black text-[#3a8d44]">{sigla}</span>
              </div>
              <div>
                <p class="text-sm font-bold text-[#1a3044]">{nome}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- RISCOS -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Atenção</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Riscos pela ausência do PGRCC</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Consequências diretas para obras e construtoras sem o plano elaborado adequadamente.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: 'tabler:file-x', text: 'Reprovação do projeto ou negativa de alvará de construção pela prefeitura' },
          { icon: 'tabler:receipt-tax', text: 'Multas por descarte irregular de resíduos em locais não autorizados' },
          { icon: 'tabler:ban', text: 'Embargo da obra por irregularidade ambiental durante a execução' },
          { icon: 'tabler:alert-circle', text: 'Responsabilidade civil e administrativa por contaminação do solo ou recursos hídricos' },
          { icon: 'tabler:building-bank', text: 'Impedimento para obtenção de financiamentos com exigências de conformidade ambiental' },
        ].map(({ icon, text }) => (
          <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-slate-100 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <Icon name={icon} class="w-5 h-5 text-orange-500" />
            </div>
            <p class="text-sm text-slate-600 leading-snug">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO ATUAMOS -->
  <section id="como-atuamos" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como a Triaxis elabora o PGRCC</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Processo técnico alinhado às exigências municipais e às normas da CONAMA e ABNT.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          {
            num: '01',
            titulo: 'Análise do projeto e da obra',
            desc: 'Levantamento das características da construção: tipo, porte, etapas previstas e estimativa de volume de resíduos gerados por classe.',
          },
          {
            num: '02',
            titulo: 'Identificação das exigências municipais',
            desc: 'Verificação da legislação municipal aplicável ao empreendimento, incluindo pontos de coleta autorizados, transportadores licenciados e áreas de destinação aceitas.',
          },
          {
            num: '03',
            titulo: 'Elaboração do plano técnico',
            desc: 'Redação do PGRCC com todos os elementos exigidos: classificação dos resíduos, fluxograma de segregação, responsabilidades, destinação final e cronograma.',
          },
          {
            num: '04',
            titulo: 'Suporte na aprovação e execução',
            desc: 'Orientação para protocolo junto à prefeitura e acompanhamento técnico durante a obra para garantir a aderência ao plano aprovado.',
          },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-7 border border-white/10">
            <span class="text-3xl font-black text-[#3a8d44] opacity-60 mb-3 block">{num}</span>
            <h3 class="text-white font-bold text-base mb-2">{titulo}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que a construtora recebe</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: 'tabler:clipboard-list',
            titulo: 'PGRCC completo',
            desc: 'Documento técnico elaborado conforme CONAMA 307 e legislação municipal, pronto para protocolo.',
          },
          {
            icon: 'tabler:table',
            titulo: 'Estimativa de volumes por classe',
            desc: 'Planilha com quantitativo estimado de cada tipo de resíduo por fase da obra.',
          },
          {
            icon: 'tabler:route',
            titulo: 'Fluxograma de destinação',
            desc: 'Representação visual do fluxo de cada classe de resíduo desde a geração até a destinação final.',
          },
          {
            icon: 'tabler:map-2',
            titulo: 'Locais de destinação licenciados',
            desc: 'Relação de áreas de transbordo, triagem, reciclagem e aterros autorizados no município.',
          },
          {
            icon: 'tabler:id',
            titulo: 'ART/RRT do responsável técnico',
            desc: 'Anotação de Responsabilidade Técnica do engenheiro ambiental responsável pela elaboração.',
          },
          {
            icon: 'tabler:headset',
            titulo: 'Suporte durante a obra',
            desc: 'Atendimento técnico para adequações no plano decorrentes de mudanças no escopo da construção.',
          },
        ].map(({ icon, titulo, desc }) => (
          <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50">
            <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center mb-4">
              <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
            </div>
            <h3 class="text-sm font-bold text-[#1a3044] mb-1">{titulo}</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFÍCIOS + DIFERENCIAIS -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 tx-fade">

      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Resultados</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Benefícios para a construtora</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:shield-check', text: 'Aprovação de projetos e alvarás sem pendências ambientais relacionadas à gestão de resíduos' },
            { icon: 'tabler:clock', text: 'Agilidade no processo de aprovação com documentação técnica correta desde o protocolo' },
            { icon: 'tabler:coins', text: 'Redução de custos com destinação ao priorizar a reciclagem e o reaproveitamento de resíduos Classe A e B' },
            { icon: 'tabler:scale', text: 'Eliminação do risco de responsabilidade civil por descarte irregular durante ou após a obra' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Diferenciais</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Por que escolher a Triaxis</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:map-pin', text: 'Conhecimento das exigências específicas de cada município atendido em Minas Gerais' },
            { icon: 'tabler:certificate', text: 'PGRCC elaborado por engenheiro ambiental habilitado, com emissão de ART' },
            { icon: 'tabler:clock', text: 'Prazos de entrega compatíveis com o cronograma de aprovação da obra' },
            { icon: 'tabler:refresh', text: 'Disponibilidade para revisão do plano em caso de alteração de projeto ou escopo da obra' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#1a3044]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center tx-fade">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Obra em conformidade desde o início</p>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Solicite a elaboração do PGRCC para o seu empreendimento.
      </h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        A Triaxis elabora o plano com base nas características reais da obra e nas exigências do município, com prazo compatível com o cronograma de aprovação do projeto.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20uma%20proposta%20para%20elaboração%20de%20PGRCC."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Falar com especialista
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors">
          Enviar mensagem
        </a>
      </div>
    </div>
  </section>

  <Footer {...footerData} />
</Layout>
