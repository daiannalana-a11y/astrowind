---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Monitoramento Ambiental e Relatórios Técnicos em MG | Triaxis',
  description: 'Monitoramento ambiental e relatórios técnicos auditáveis para licenças, condicionantes, fiscalizações e auditorias. Atendimento em MG e remoto conforme escopo.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">Monitoramento Ambiental</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-4xl font-black text-white leading-tight mb-5">
        Monitoramento Ambiental e Relatórios Técnicos<br class="hidden md:block" />
        <span class="text-[#6fcf7f]">prontos para fiscalização, auditorias e condicionantes</span>
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-3 max-w-2xl mx-auto">
        A Triaxis executa monitoramentos ambientais e elabora relatórios técnicos claros, rastreáveis e alinhados às exigências legais e contratuais,
        para atender licenças, condicionantes, fiscalizações e auditorias.
        Atendimento presencial em Minas Gerais e remoto conforme o escopo.
      </p>
      <p class="text-sm text-slate-400 italic mb-6">
        Menos risco de autuacao, mais previsibilidade e documentacao organizada quando alguem pedir.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        {[
          { icon: 'tabler:list-check', text: 'Escopo definido conforme órgão, licença, condicionante ou contratante' },
          { icon: 'tabler:file-report', text: 'Relatórios objetivos, auditáveis e com evidências organizadas' },
          { icon: 'tabler:history', text: 'Controle de prazos e histórico de monitoramentos para rastreabilidade' },
          { icon: 'tabler:certificate', text: 'ART emitida quando exigida pelo escopo, órgão ou contratante' },
        ].map(({ icon, text }) => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/10">
            <Icon name={icon} class="w-4 h-4 text-[#6fcf7f]" />
            {text}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20or%C3%A7amento%20de%20Monitoramento%20Ambiental%20e%20Relat%C3%B3rios%20T%C3%A9cnicos.%20Empresa%3A%20___%20%7C%20Cidade%3A%20___%20%7C%20Atividade%3A%20___%20%7C%20Licen%C3%A7a%2Fcondicionante%3A%20___%20%7C%20Prazo%3A%20___"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Solicitar orçamento de monitoramento
        </a>
        <a href="https://wa.me/5531994915126"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Falar com a Triaxis
        </a>
      </div>
    </div>
  </section>

  <!-- O QUE É + QUANDO PRECISA -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">O que é</p>
          <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é Monitoramento e Relatórios Técnicos Ambientais</h2>
          <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
          <p class="text-slate-600 leading-relaxed mb-4">
            E o serviço que garante o acompanhamento periódico de parâmetros ambientais e a elaboração de relatórios técnicos exigidos por licenças, condicionantes, contratos ou fiscalizações.
          </p>
          <p class="text-slate-600 leading-relaxed mb-6">
            Vai além de medir e entregar papel: o foco e interpretar resultados, organizar evidências e manter histórico, reduzindo risco de não conformidade e correria de última hora.
          </p>
          <div class="space-y-3 mb-6">
            {[
              { icon: 'tabler:scale', text: 'Atendimento a exigências legais e contratuais' },
              { icon: 'tabler:calendar-check', text: 'Controle de prazos e recorrência por cronograma' },
              { icon: 'tabler:shield-check', text: 'Base técnica para fiscalizações e auditorias' },
              { icon: 'tabler:bulb', text: 'Suporte à tomada de decisão e priorização de ações' },
            ].map(({ icon, text }) => (
              <div class="flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Icon name={icon} class="w-4 h-4 text-[#3a8d44]" />
                </div>
                <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
          <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20confirmar%20se%20minha%20empresa%20precisa%20de%20monitoramento%20e%20relat%C3%B3rios%20ambientais.%20Empresa%3A%20___%20%7C%20Cidade%3A%20___%20%7C%20Atividade%3A%20___"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-6 py-3 rounded-full transition-colors text-sm shadow-md">
            <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
            Ver se minha empresa precisa
          </a>
        </div>

        <div>
          <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Situações comuns</p>
          <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Quando sua empresa precisa desse serviço</h2>
          <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
          <p class="text-slate-600 text-sm leading-relaxed mb-5">
            O monitoramento e indicado sempre que há exigência formal (licença/condicionante/contrato) ou risco de fiscalização.
          </p>
          <div class="space-y-2">
            {[
              'Condicionantes de licença ambiental',
              'Exigência de órgão ambiental municipal ou estadual (conforme competência)',
              'Exigência de contratante (obras, indústria, mineração, etc.)',
              'Necessidade de comprovar controle ambiental periódico',
              'Histórico de fiscalização, notificação ou autuação',
              'Renovação de licença ambiental',
              'Auditorias internas ou externas (ISO, compliance, due diligence)',
            ].map((item) => (
              <div class="flex items-start gap-3">
                <Icon name="tabler:circle-check-filled" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600 leading-snug">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TIPOS DE MONITORAMENTO -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Escopo</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Tipos de monitoramento e relatórios atendidos</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 max-w-2xl mx-auto text-sm">
          O escopo e definido conforme a atividade, a licença, as condicionantes e as exigências aplicáveis.
          Parte do serviço pode ser remota; monitoramentos que exigem campo são executados presencialmente.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-6">
        {[
          { icon: 'tabler:recycle', titulo: 'Monitoramento de resíduos', desc: 'Controle quantitativo, movimentação, rastreabilidade e organização de evidências (CTR/MTR, notas, contratos)' },
          { icon: 'tabler:droplet', titulo: 'Acompanhamento de efluentes', desc: 'Interface com laboratório, consolidação de resultados e relatório técnico (CONAMA 357/396/430 e normas locais)' },
          { icon: 'tabler:wind', titulo: 'Emissões, poeira e ruído', desc: 'Quando exigido: acompanhamento, interface com medição e relatório técnico (ABNT NBR 10.151 e legislação aplicável)' },
          { icon: 'tabler:list-check', titulo: 'Condicionantes ambientais', desc: 'Acompanhamento e consolidação de condicionantes de licença, com controle de prazos e histórico de cumprimento' },
          { icon: 'tabler:file-certificate', titulo: 'Relatórios de atendimento', desc: 'Relatórios de conformidade com licenças, condicionantes e resposta técnica a notificações e fiscalizações' },
          { icon: 'tabler:building-factory-2', titulo: 'Relatórios para contratantes', desc: 'Relatórios periódicos de controle ambiental para obras e operações industriais/comerciais exigidos por cliente' },
        ].map(({ icon, titulo, desc }) => (
          <div class="p-6 rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center mb-4">
              <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
            </div>
            <h3 class="text-sm font-bold text-[#1a3044] mb-2">{titulo}</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6">
        <p class="text-xs text-amber-700 leading-relaxed">
          <span class="font-bold">Nota:</span> Análises e laudos laboratoriais, quando exigidos, são realizados por laboratórios acreditados/qualificados.
          Os custos são orçados conforme o escopo e a exigência do órgão ou contratante.
        </p>
      </div>
      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20ver%20o%20escopo%20de%20monitoramento%20aplic%C3%A1vel%20%C3%A0%20minha%20atividade.%20Empresa%3A%20___%20%7C%20Cidade%3A%20___%20%7C%20Atividade%3A%20___%20%7C%20Licen%C3%A7a%2Fcondicionante%3A%20___"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Ver escopo aplicável à minha atividade
        </a>
      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que a Triaxis entrega no monitoramento ambiental</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 max-w-xl mx-auto text-sm">
          Entregáveis claros, rastreáveis e alinhados às exigências reais, para você ter documentação pronta quando for cobrada.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        {[
          { n: '01', text: 'Leitura e organização das exigências aplicáveis (licença, condicionantes ou contrato)' },
          { n: '02', text: 'Definição do escopo de monitoramento e parâmetros a acompanhar' },
          { n: '03', text: 'Planejamento de periodicidade, cronograma e prazos de entrega' },
          { n: '04', text: 'Checklists de campo e acompanhamento da execução' },
          { n: '05', text: 'Organização de dados e evidências (fotos, registros, planilhas, laudos)' },
          { n: '06', text: 'Relatório técnico ambiental em PDF, com estrutura auditável e anexos' },
          { n: '07', text: 'Interpretação dos resultados e comparativo com padrões legais (quando aplicável)' },
          { n: '08', text: 'Registro histórico de monitoramentos para rastreabilidade ao longo do tempo' },
          { n: '09', text: 'Orientações técnicas em caso de não conformidade (plano de ação básico)' },
          { n: '10', text: 'ART, quando exigida pelo escopo, órgão ambiental ou contratante' },
        ].map(({ n, text }) => (
          <div class="flex items-start gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-100">
            <div class="w-9 h-9 rounded-xl bg-[#1a3044] flex items-center justify-center flex-shrink-0">
              <span class="text-xs font-black text-[#6fcf7f]">{n}</span>
            </div>
            <p class="text-sm text-slate-600 leading-snug">{text}</p>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20receber%20um%20exemplo%20de%20relat%C3%B3rio%20t%C3%A9cnico%20ambiental%20(anonimizado).%20Empresa%3A%20___%20%7C%20Atividade%3A%20___"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Receber exemplo de relatório técnico
        </a>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-atuamos" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona o Monitoramento Ambiental (passo a passo)</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Processo estruturado, sem burocracia desnecessária, com começo, meio e fim claros.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6">
        {[
          { num: '01', titulo: 'Reunião de alinhamento', desc: '15 a 30 min sobre atividade, exigências, prazos e histórico disponível' },
          { num: '02', titulo: 'Levantamento de exigências', desc: 'Leitura das condicionantes, contrato ou notificação para definir escopo correto' },
          { num: '03', titulo: 'Definição do escopo', desc: 'Parâmetros, periodicidade, pontos de controle e responsabilidades' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-6 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6">
        {[
          { num: '04', titulo: 'Planejamento', desc: 'Cronograma de monitoramento, agenda de campo e checklist de execução' },
          { num: '05', titulo: 'Execução', desc: 'Monitoramento em campo e/ou consolidação de dados e laudos laboratoriais' },
          { num: '06', titulo: 'Análise e interpretação', desc: 'Consolidação das informações e comparativo com padrões legais exigidos' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-6 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
        {[
          { num: '07', titulo: 'Relatório técnico', desc: 'Elaboração do relatório em PDF com estrutura auditável, evidências e anexos' },
          { num: '08', titulo: 'Entrega + orientações', desc: 'Entrega do relatório com orientações técnicas e, se houver não conformidade, plano de acao básico' },
          { num: '09', titulo: 'Acompanhamento recorrente', desc: 'Quando contratado: gestão de calendário, prazos e ciclos de monitoramento' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-6 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20entender%20como%20funciona%20o%20monitoramento%20ambiental%20no%20meu%20caso.%20Empresa%3A%20___%20%7C%20Cidade%3A%20___%20%7C%20Atividade%3A%20___"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Entender como funciona no meu caso
        </a>
      </div>
    </div>
  </section>

  <!-- PRAZOS + CHECKLIST -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">

      <!-- Prazos -->
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazos típicos de monitoramento e relatório</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
        <p class="text-slate-600 text-sm leading-relaxed mb-5">
          Os prazos variam conforme o tipo de monitoramento, necessidade de campo e exigências do órgão ou contratante.
        </p>
        <div class="space-y-3 mb-5">
          {[
            { prazo: 'Relatório de acompanhamento (sem coletas)', tempo: '5 a 10 dias' },
            { prazo: 'Monitoramento + relatório (com execução)', tempo: '10 a 30 dias' },
            { prazo: 'Monitoramento recorrente', tempo: 'Conforme periodicidade exigida (mensal, trimestral, semestral, anual)' },
          ].map(({ prazo, tempo }) => (
            <div class="flex items-start gap-4 p-4 bg-slate-50 rounded-xl border border-slate-100">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0 mt-0.5">
                <Icon name="tabler:clock" class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <div>
                <span class="text-xs font-bold text-[#1a3044] block">{prazo}</span>
                <span class="text-sm font-semibold text-[#3a8d44]">{tempo}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 mb-5">
          <p class="text-xs text-orange-700 font-semibold mb-1">O que pode impactar o prazo:</p>
          <ul class="space-y-1">
            {[
              'Dependência de análises e laudos laboratoriais',
              'Atraso no envio de informações ou documentos pelo cliente',
              'Exigências específicas do órgão ambiental ou contratante',
            ].map((item) => (
              <li class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-orange-500 flex-shrink-0 mt-1" />
                <span class="text-xs text-orange-600">{item}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs text-orange-600 mt-2 italic">Prazos de análise e aceite por órgãos e contratantes nao dependem da Triaxis.</p>
        </div>
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20estimar%20o%20prazo%20do%20meu%20monitoramento%20e%20relat%C3%B3rio.%20Empresa%3A%20___%20%7C%20Cidade%3A%20___%20%7C%20Atividade%3A%20___%20%7C%20Prazo%20interno%3A%20___"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-5 py-3 rounded-full transition-colors text-sm shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
          Estimar prazo do meu caso
        </a>
      </div>

      <!-- Checklist + Não inclui -->
      <div>
