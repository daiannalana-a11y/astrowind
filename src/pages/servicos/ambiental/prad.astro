---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'PRAD / RAD em MG | Recuperação de Áreas Degradadas com Plano Técnico | Triaxis',
  description: 'Elaboração de PRAD/RAD com diagnóstico de campo, estratégia de recuperação, cronograma e evidências. Atendimento a condicionantes e exigências de órgão ambiental em MG.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">PRAD / RAD</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-4xl font-black text-white leading-tight mb-5">
        PRAD / RAD: plano técnico executável<br class="hidden md:block" />
        <span class="text-[#6fcf7f]">e defensável no licenciamento</span>
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-3 max-w-2xl mx-auto">
        A Triaxis elabora PRAD/RAD para atender exigências do órgão ambiental, condicionantes de licença, mineração, obras e passivos ambientais,
        com diagnóstico de campo, soluções técnicas, cronograma e evidências.
      </p>
      <p class="text-sm text-slate-400 italic mb-6">
        Nada de "projeto de prateleira". Entregamos um plano alinhado à realidade da área, ao uso futuro e ao formato exigido no seu processo.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        {[
          { icon: 'tabler:clipboard-check', text: 'PRAD/RAD no modelo exigido pelo órgão (conforme TR/roteiro)' },
          { icon: 'tabler:map-search', text: 'Diagnóstico real: solo, relevo, drenagem, estabilidade e riscos' },
          { icon: 'tabler:tools', text: 'Medidas de estabilização, controle de erosão e revegetação' },
          { icon: 'tabler:calendar-stats', text: 'Cronograma por etapas + indicadores e evidências de comprovação' },
          { icon: 'tabler:certificate', text: 'ART emitida quando aplicável ao escopo/exigência' },
        ].map(({ icon, text }) => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/10">
            <Icon name={icon} class="w-4 h-4 text-[#6fcf7f]" />
            {text}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20or%C3%A7amento%20de%20PRAD%2FRAD.%0A%0A1)%20Cidade%2FUF%3A%20____%0A2)%20%C3%81rea%20aprox.%20(ha%20ou%20m%C2%B2)%3A%20____%0A3)%20Atividade%3A%20____%0A4)%20Tipo%20de%20degrada%C3%A7%C3%A3o%20(talude%2Feros%C3%A3o%2Fcava%2Fsolo%20exposto%20etc.)%3A%20____%0A5)%20Existe%20condicionante%2Fof%C3%ADcio%2FTR%2FTAC%3F%20____%0A6)%20Prazo%20exigido%3A%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Solicitar orçamento de PRAD / RAD
        </a>
        <a href="https://wa.me/5531994915126"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Falar com a Triaxis
        </a>
      </div>
    </div>
  </section>

  <!-- O QUE É + NOMENCLATURA -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Conceito</p>
          <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é PRAD / RAD</h2>
          <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
          <p class="text-slate-600 leading-relaxed mb-4">
            PRAD/RAD e um estudo/plano técnico que define como uma área degradada será estabilizada, recuperada, reabilitada ou recomposta, atendendo exigências do órgão ambiental e condicionantes do licenciamento.
          </p>
          <p class="text-slate-600 leading-relaxed mb-6">
            Nao se resume a "plantar mudas". Um PRAD/RAD bem feito combina diagnóstico ambiental, controle de processos erosivos, drenagem, revegetação quando aplicável, cronograma, indicadores e monitoramento, considerando solo, relevo, riscos e uso futuro da área.
          </p>
          <div class="space-y-3 mb-6">
            {[
              'Atende exigências legais, condicionantes e notificações do órgão ambiental',
              'Orienta a execução e reduz risco de retrabalho e indeferimento por inconsistência técnica',
              'Define etapas, prazos, responsáveis, registros e evidências de comprovação',
              'Obrigatório em muitos licenciamentos, especialmente em mineração e obras com movimentação de solo',
            ].map((item) => (
              <div class="flex items-start gap-3">
                <Icon name="tabler:circle-check-filled" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600 leading-snug">{item}</p>
              </div>
            ))}
          </div>
          <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Pode%20me%20ajudar%20a%20confirmar%20se%20meu%20caso%20exige%20PRAD%2FRAD%3F%20Cidade%3A%20____%20%7C%20Atividade%3A%20____%20%7C%20Exig%C3%AAncia%3A%20____"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-6 py-3 rounded-full transition-colors text-sm shadow-md">
            <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
            Ver se meu caso exige PRAD / RAD
          </a>
        </div>

        <!-- Nomenclatura -->
        <div class="bg-[#1a3044]/5 border border-[#1a3044]/10 rounded-2xl p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-9 h-9 rounded-lg bg-[#1a3044] flex items-center justify-center flex-shrink-0">
              <Icon name="tabler:info-circle" class="w-5 h-5 text-[#6fcf7f]" />
            </div>
            <h3 class="font-bold text-[#1a3044] text-base">PRAD, RAD, PTRF... a exigência e a mesma</h3>
          </div>
          <p class="text-slate-600 text-sm leading-relaxed mb-4">
            Cada estado e órgão pode usar nomenclaturas e formatos diferentes: PRAD, RAD, Plano de Recuperação, PTRF e outros.
            A Triaxis adapta o conteúdo e a estrutura ao roteiro/termo de referência do seu processo, para evitar devolutivas por forma.
          </p>
          <div class="grid grid-cols-2 gap-3 mb-5">
            {['PRAD', 'RAD', 'PTRF', 'Plano de Recuperação', 'Plano de Reabilitação', 'Plano de Recomposição'].map((nome) => (
              <div class="flex items-center gap-2 bg-white rounded-lg px-3 py-2 border border-slate-100">
                <Icon name="tabler:file-text" class="w-4 h-4 text-[#3a8d44]" />
                <span class="text-xs font-semibold text-[#1a3044]">{nome}</span>
              </div>
            ))}
          </div>
          <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Vou%20anexar%20o%20of%C3%ADcio%2FTR%2Fcondicionante%20para%20voc%C3%AAs%20avaliarem%20o%20formato%20exigido."
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[#3a8d44] font-bold text-sm hover:underline">
            <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
            Enviar a exigência (ofício/TR) para avaliarmos
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUANDO PRECISA + PARA QUEM -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

        <!-- Situações -->
        <div>
          <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Situações comuns</p>
          <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Quando sua área precisa de PRAD / RAD</h2>
          <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
          <p class="text-slate-600 text-sm leading-relaxed mb-5">
            O PRAD/RAD e exigido ou recomendado sempre que há degradação ambiental associada a uma atividade, obra ou passivo que precise ser regularizado, estabilizado ou recuperado.
          </p>
          <div class="space-y-2">
            {[
              'Condicionante de licença ambiental (LP/LI/LO e renovações)',
              'Mineração, extração, áreas de apoio, pilhas, vias internas e bota-fora',
              'Obras com supressão, cortes/aterros, terraplenagem e movimentação de solo',
              'Passivos ambientais identificados em fiscalização, auditoria, due diligence ou exigência de contratante',
              'Encerramento/desativação de atividade com obrigação de recuperação',
              'Adequações exigidas por órgão ambiental ou Ministério Público',
              'Regularização ambiental de áreas já impactadas',
            ].map((item) => (
              <div class="flex items-start gap-3">
                <Icon name="tabler:circle-check-filled" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600 leading-snug">{item}</p>
              </div>
            ))}
          </div>
          <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20confirmar%20se%20preciso%20de%20PRAD%2FRAD.%20Cidade%3A%20____%20%7C%20Situa%C3%A7%C3%A3o%3A%20____%20%7C%20Existe%20licen%C3%A7a%2Fcondicionante%3F%20____"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-5 py-3 rounded-full transition-colors text-sm shadow-md mt-5">
            <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
            Confirmar exigência no meu caso
          </a>
        </div>

        <!-- Segmentos -->
        <div>
          <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Público-alvo</p>
          <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Para quem a Triaxis faz PRAD / RAD</h2>
          <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
          <div class="space-y-4">
            {[
              { icon: 'tabler:mountain', label: 'Mineração e áreas de apoio', desc: 'Cavas, pilhas, vias internas, bota-fora e áreas operacionais' },
              { icon: 'tabler:crane', label: 'Construtoras e obras civis', desc: 'Terraplenagem, cortes/aterros, contenções e taludes instáveis' },
              { icon: 'tabler:building-factory', label: 'Indústrias e pátios', desc: 'Passivos ambientais e áreas degradadas em unidades operacionais' },
              { icon: 'tabler:tree', label: 'Proprietários rurais', desc: 'Áreas impactadas que precisam de regularização ambiental (caso a caso)' },
              { icon: 'tabler:chart-bar', label: 'Empresas com exigências ESG', desc: 'Auditorias, compliance, due diligence e exigências contratuais' },
            ].map(({ icon, label, desc }) => (
              <div class="flex items-start gap-4 p-4 bg-white rounded-xl border border-slate-100">
                <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                  <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
                </div>
                <div>
                  <p class="text-sm font-bold text-[#1a3044]">{label}</p>
                  <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que a Triaxis entrega no PRAD / RAD</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 max-w-xl mx-auto text-sm">
          Entregáveis técnicos, claros e alinhados à realidade da área, com foco em execução prática e atendimento às exigências do órgão.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Fase 1 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-[#1a3044] flex items-center justify-center">
              <span class="text-xs font-black text-[#6fcf7f]">01</span>
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm">Diagnóstico da área</h3>
          </div>
          <div class="space-y-2">
            {[
              'Caracterização da área e entorno (uso do solo, sensibilidade e restrições)',
              'Identificação do tipo e grau de degradação',
              'Avaliação de solo, relevo, drenagem e estabilidade',
              'Histórico da atividade e levantamento das exigências (TR/ofícios)',
              'Avaliação de riscos ambientais e operacionais',
              'Registro fotográfico técnico (pontos e referências)',
            ].map((item) => (
              <div class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-[#3a8d44] flex-shrink-0 mt-1" />
                <p class="text-xs text-slate-600 leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Fase 2 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-[#1a3044] flex items-center justify-center">
              <span class="text-xs font-black text-[#6fcf7f]">02</span>
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm">Elaboração do PRAD / RAD</h3>
          </div>
          <div class="space-y-2">
            {[
              'Objetivos da recuperação (estabilização, reabilitação, recomposição e/ou uso futuro)',
              'Diretrizes técnicas e metodologia por etapas',
              'Medidas de controle de erosão, drenagem e estabilização',
              'Recomposição/revegetação quando aplicável (método, manutenção e indicadores)',
              'Cronograma físico de implantação (etapas, frentes e marcos)',
              'Indicadores e critérios de sucesso + plano de monitoramento',
              'Ajuste ao formato exigido pelo órgão (quando aplicável)',
            ].map((item) => (
              <div class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-[#3a8d44] flex-shrink-0 mt-1" />
                <p class="text-xs text-slate-600 leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Fase 3 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-[#3a8d44]/30 relative">
          <div class="absolute -top-3 right-4">
            <span class="bg-[#3a8d44] text-white text-xs font-bold px-3 py-1 rounded-full">Opcional</span>
          </div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-[#3a8d44] flex items-center justify-center">
              <span class="text-xs font-black text-white">03</span>
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm">Peças gráficas + acompanhamento</h3>
          </div>
          <div class="space-y-2">
            {[
              'Croqui/planta/mapas (quando aplicável)',
              'Delimitação da área e pontos relevantes (quando houver dados geográficos)',
              'Quadro-resumo de etapas, prazos e evidências',
              'Orientação técnica para execução (cliente/terceiros)',
              'Relatórios de acompanhamento e monitoramento',
              'Registro fotográfico e checklist de evidências',
              'Ajustes técnicos conforme evolução da área',
            ].map((item) => (
              <div class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-[#3a8d44] flex-shrink-0 mt-1" />
                <p class="text-xs text-slate-600 leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-8">
        <p class="text-xs text-amber-700 leading-relaxed">
          <span class="font-bold">Alinhamento de escopo:</span> O PRAD/RAD e um plano técnico. A execução física (obras, plantio, terraplenagem, insumos e mao de obra) e responsabilidade do cliente ou de terceiros contratados. A Triaxis pode acompanhar tecnicamente quando previsto em contrato.
        </p>
      </div>

      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20receber%20o%20escopo%20completo%20do%20PRAD%2FRAD%20(entreg%C3%A1veis%2C%20prazos%20e%20condi%C3%A7%C3%B5es)."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Receber escopo completo do PRAD / RAD
        </a>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-atuamos" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona o PRAD / RAD (passo a passo)</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Processo objetivo, com rastreabilidade e alinhamento às exigências do seu processo.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-5">
        {[
          { num: '01', titulo: 'Reunião inicial', desc: 'Entendimento da área, urgência e exigência (condicionante/ofício/TR)' },
          { num: '02', titulo: 'Checklist de dados', desc: 'Documentos, licenças, imagens, mapas e coordenadas necessários' },
          { num: '03', titulo: 'Levantamento', desc: 'Análise das informações existentes (licenças, relatórios, imagens e mapas)' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-6 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-5">
        {[
          { num: '04', titulo: 'Visita técnica e diagnóstico', desc: 'Levantamento de campo quando necessário: solo, relevo, erosão, drenagem e registro fotográfico' },
          { num: '05', titulo: 'Estratégia de recuperação', desc: 'Definição de metodologia, medidas de controle, revegetação (quando aplicável) e cronograma' },
          { num: '06', titulo: 'Elaboração do PRAD/RAD', desc: 'Redação do plano e anexos conforme o formato exigido pelo órgão' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-6 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
        {[
          { num: '07', titulo: 'Revisão e ajustes', desc: 'Alinhamento com o cliente: consistência técnica e adequação ao formato do órgão' },
          { num: '08', titulo: 'Entrega final', desc: 'PDF + anexos (croquis, quadros, fotos) conforme escopo contratado' },
          { num: '09', titulo: 'Acompanhamento', desc: 'Quando contratado: relatórios de evolução, registro fotográfico e evidências de execução' },
        ].map(({ num, titulo, desc }) => (
