---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Plano de Gerenciamento de Resíduos Sólidos (PGRS) | Triaxis Consultoria',
  description: 'Elaboração e implantação do PGRS para empresas em Minas Gerais. Conformidade com a PNRS, classificação de resíduos, destinação adequada e gestão documental. Triaxis Consultoria.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">PGRS</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        Plano de Gerenciamento de Resíduos Sólidos
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
        Elaboração técnica do PGRS em conformidade com a Política Nacional de Resíduos Sólidos (Lei 12.305/2010). Classificação, destinação adequada, rastreabilidade documental e suporte à implantação.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20solicitar%20uma%20proposta%20para%20elaboração%20de%20PGRS."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Solicitar proposta
        </a>
        <a href="#como-atuamos"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Como funciona
        </a>
      </div>
    </div>
  </section>

  <!-- INTRODUÇÃO -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center tx-fade">
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Contexto</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">O que é o PGRS e por que sua empresa precisa</h2>
        <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <p class="text-slate-600 leading-relaxed mb-4">
          O Plano de Gerenciamento de Resíduos Sólidos é um instrumento legal obrigatório para empresas geradoras de resíduos, previsto na Lei Federal 12.305/2010. Define responsabilidades, procedimentos e metas para a geração, acondicionamento, coleta, transporte, tratamento e destinação final dos resíduos produzidos pela atividade.
        </p>
        <p class="text-slate-600 leading-relaxed">
          A ausência do PGRS ou sua elaboração inadequada expõe a empresa a autuações, multas e restrições em processos de licenciamento. A Triaxis elabora o plano com base no inventário real dos resíduos gerados, nas exigências do órgão ambiental competente e nas normas da ABNT.
        </p>
      </div>
      <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
        <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">Quem é obrigado ao PGRS</p>
        <div class="space-y-4">
          {[
            { icon: 'tabler:building-factory', label: 'Indústrias e manufaturados', desc: 'Geradoras de resíduos industriais Classes I e II' },
            { icon: 'tabler:building-store', label: 'Estabelecimentos comerciais', desc: 'Conforme porte e tipo de resíduo gerado' },
            { icon: 'tabler:heartbeat', label: 'Serviços de saúde', desc: 'RSS com exigências específicas de segregação e descarte' },
            { icon: 'tabler:bulldozer', label: 'Construtoras e incorporadoras', desc: 'Obrigadas ao PGRCC conforme legislação municipal' },
          ].map(({ icon, label, desc }) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <div>
                <p class="text-sm font-bold text-[#1a3044]">{label}</p>
                <p class="text-xs text-slate-500">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- RISCOS -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Atenção</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Consequências da não conformidade</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Riscos concretos para empresas sem PGRS atualizado e implantado.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: 'tabler:receipt-tax', text: 'Multas administrativas por ausência ou inadequação do plano de gerenciamento' },
          { icon: 'tabler:ban', text: 'Bloqueio ou não renovação de licenças ambientais por pendência no PGRS' },
          { icon: 'tabler:file-x', text: 'Irregularidade no Manifesto de Transporte de Resíduos (MTR) por ausência de base documental' },
          { icon: 'tabler:alert-circle', text: 'Responsabilidade solidária por destinação inadequada de resíduos por terceiros' },
          { icon: 'tabler:building-bank', text: 'Restrições em processos de due diligence, certificações e acesso a financiamentos' },
        ].map(({ icon, text }) => (
          <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-slate-100 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <Icon name={icon} class="w-5 h-5 text-orange-500" />
            </div>
            <p class="text-sm text-slate-600 leading-snug">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO ATUAMOS -->
  <section id="como-atuamos" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-4xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como a Triaxis elabora o PGRS</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Processo técnico estruturado, com levantamento in loco, classificação normativa e entregáveis completos.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          {
            num: '01',
            titulo: 'Inventário de resíduos',
            desc: 'Levantamento de todos os resíduos gerados pela atividade, com identificação por processo, quantidade estimada, estado físico e frequência de geração.',
          },
          {
            num: '02',
            titulo: 'Classificação conforme ABNT NBR 10.004',
            desc: 'Classificação técnica de cada resíduo em Classe I (perigosos) ou Classe II (não perigosos), com base nas características físico-químicas e nos anexos normativos.',
          },
          {
            num: '03',
            titulo: 'Definição de destinação e responsabilidades',
            desc: 'Indicação de transportadores e destinadores licenciados para cada tipo de resíduo, com definição de responsabilidades internas e procedimentos operacionais.',
          },
          {
            num: '04',
            titulo: 'Elaboração do plano e apoio à implantação',
            desc: 'Redação do PGRS conforme exigências do órgão licenciador, com orientação para implantação dos procedimentos e controle documental via MTR.',
          },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-7 border border-white/10">
            <span class="text-3xl font-black text-[#3a8d44] opacity-60 mb-3 block">{num}</span>
            <h3 class="text-white font-bold text-base mb-2">{titulo}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENTREGÁVEIS -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que a empresa recebe</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: 'tabler:clipboard-list',
            titulo: 'PGRS completo',
            desc: 'Documento técnico elaborado conforme as exigências legais e do órgão licenciador competente.',
          },
          {
            icon: 'tabler:table',
            titulo: 'Inventário de resíduos',
            desc: 'Planilha detalhada com classificação, quantidade e frequência de geração de cada resíduo.',
          },
          {
            icon: 'tabler:route',
            titulo: 'Fluxo de destinação',
            desc: 'Mapeamento dos fluxos de cada resíduo até a destinação final, com transportadores e destinadores indicados.',
          },
          {
            icon: 'tabler:file-certificate',
            titulo: 'Modelo de MTR',
            desc: 'Orientação e modelos para emissão do Manifesto de Transporte de Resíduos no sistema SINIR ou estadual.',
          },
          {
            icon: 'tabler:book',
            titulo: 'Procedimentos operacionais',
            desc: 'Instruções internas para acondicionamento, segregação, identificação e movimentação de resíduos.',
          },
          {
            icon: 'tabler:headset',
            titulo: 'Suporte técnico',
            desc: 'Atendimento para dúvidas durante a implantação e orientação em eventuais exigências do órgão ambiental.',
          },
        ].map(({ icon, titulo, desc }) => (
          <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50">
            <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center mb-4">
              <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
            </div>
            <h3 class="text-sm font-bold text-[#1a3044] mb-1">{titulo}</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFÍCIOS + DIFERENCIAIS -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 tx-fade">

      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Resultados</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Benefícios para a empresa</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:shield-check', text: 'Conformidade com a PNRS e com as condicionantes do licenciamento ambiental' },
            { icon: 'tabler:coins', text: 'Redução de custos com descarte por meio de estratégias de reaproveitamento e reciclagem' },
            { icon: 'tabler:scale', text: 'Eliminação de responsabilidade solidária por destinação indevida de resíduos' },
            { icon: 'tabler:star', text: 'Melhora no desempenho ambiental e na imagem da empresa perante clientes e certificadoras' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Diferenciais</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Por que escolher a Triaxis</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
        <div class="space-y-4">
          {[
            { icon: 'tabler:certificate', text: 'PGRS elaborado por profissionais habilitados, com ART/RRT quando exigido pelo órgão' },
            { icon: 'tabler:map-pin', text: 'Conhecimento das exigências específicas de SUPRAM, SEMAD e órgãos municipais em Minas Gerais' },
            { icon: 'tabler:settings', text: 'Orientação prática para implantação dos procedimentos internos sem impactar a rotina operacional' },
            { icon: 'tabler:refresh', text: 'Suporte para revisão e atualização periódica do plano conforme mudanças na atividade ou na legislação' },
          ].map(({ icon, text }) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
                <Icon name={icon} class="w-5 h-5 text-[#1a3044]" />
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-3xl mx-auto text-center tx-fade">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Regularize a gestão de resíduos</p>
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Solicite a elaboração do PGRS da sua empresa.
      </h2>
      <p class="text-slate-300 mb-8 leading-relaxed">
        A Triaxis elabora o plano com base no inventário real dos resíduos gerados, nas exigências do órgão licenciador e nas normas técnicas aplicáveis.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Olá!%20Gostaria%20de%20uma%20proposta%20para%20elaboração%20de%20PGRS."
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Falar com especialista
        </a>
        <a href="/contact"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full text-base transition-colors">
          Enviar mensagem
        </a>
      </div>
    </div>
  </section>

  <Footer {...footerData} />
</Layout>
