---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'PGRS com Implantação | Plano de Gerenciamento de Resíduos Sólidos | Triaxis',
  description: 'Elaboração de PGRS com implantação prática: rotina, controles e evidências para conformidade e fiscalização. Presencial em MG e remoto no Brasil.',
};
---

<Layout metadata={metadata}>
  <Header {...headerData} isSticky />

  <!-- BREADCRUMB -->
  <nav class="bg-slate-100 border-b border-slate-200 px-4 py-2.5">
    <div class="max-w-5xl mx-auto flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-[#3a8d44] transition-colors">Início</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/services" class="hover:text-[#3a8d44] transition-colors">Serviços</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <a href="/servicos/ambiental" class="hover:text-[#3a8d44] transition-colors">Engenharia Ambiental</a>
      <Icon name="tabler:chevron-right" class="w-3 h-3 text-slate-400" />
      <span class="text-[#1a3044] font-semibold">PGRS</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="bg-[#1a3044] py-20 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-3">Engenharia Ambiental</p>
      <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
        PGRS com implantação:<br class="hidden md:block" />
        <span class="text-[#6fcf7f]">gestão de resíduos executável e pronta para fiscalização</span>
      </h1>
      <div class="w-20 h-1 bg-orange-500 mx-auto rounded-full mb-6"></div>
      <p class="text-lg text-slate-300 leading-relaxed mb-4 max-w-2xl mx-auto">
        A Triaxis elabora o Plano de Gerenciamento de Resíduos Sólidos e, se você quiser, apoia a implantação prática da rotina, com controles e evidências organizadas.
        Atendimento presencial em Minas Gerais e remoto para todo o Brasil.
      </p>
      <p class="text-sm text-slate-400 italic mb-6">Serviço técnico sem "plano de gaveta" — foco em rotina, controle, conformidade e comprovação.</p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        {[
          { icon: 'tabler:clipboard-check', text: 'PGRS alinhado às exigências do órgão, prefeitura e/ou contratante' },
          { icon: 'tabler:recycle', text: 'Rotina de resíduos com procedimentos simples e executáveis' },
          { icon: 'tabler:folder-check', text: 'Evidências organizadas para auditoria e fiscalização' },
          { icon: 'tabler:certificate', text: 'ART emitida quando aplicável ao escopo' },
        ].map(({ icon, text }) => (
          <span class="inline-flex items-center gap-2 bg-white/10 text-slate-200 text-xs font-medium px-4 py-2 rounded-full border border-white/10">
            <Icon name={icon} class="w-4 h-4 text-[#6fcf7f]" />
            {text}
          </span>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20or%C3%A7amento%20de%20PGRS%20(com%20ou%20sem%20implanta%C3%A7%C3%A3o).%20Empresa%3A%20____%20%7C%20Cidade%3A%20____%20%7C%20Atividade%3A%20____%20%7C%20Possui%20licen%C3%A7a%3F%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-8 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Solicitar orçamento de PGRS
        </a>
        <a href="https://wa.me/5531994915126"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-white/40 hover:border-white text-white font-bold px-8 py-3.5 rounded-full transition-colors">
          Falar com a Triaxis
        </a>
      </div>
    </div>
  </section>

  <!-- QUANDO PRECISA -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Contexto</p>
          <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-4">Quando sua empresa precisa de um PGRS?</h2>
          <div class="w-16 h-1 bg-[#3a8d44] rounded-full mb-6"></div>
          <p class="text-slate-600 leading-relaxed mb-6">
            O PGRS e recomendado (e muitas vezes exigido) para empresas que precisam organizar, comprovar e manter controle sobre os resíduos gerados na atividade.
          </p>
          <div class="space-y-3 mb-6">
            {[
              'Exigência de órgão ambiental, prefeitura, licenciamento ou renovação',
              'Exigência de contratante (obras, indústria, mineração, cadeia de fornecedores)',
              'Falta de padrão na rotina ("cada um faz de um jeito")',
              'Necessidade de comprovar destinação adequada e manter documentos em dia',
              'Documentação desorganizada ou incompleta (manifestos/CTR, certificados, contratos)',
              'Crescimento da operação, mudança de endereço, ampliação ou nova atividade',
              'Adequações internas após auditoria, ocorrência, notificação ou fiscalização',
            ].map((item) => (
              <div class="flex items-start gap-3">
                <Icon name="tabler:circle-check-filled" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
                <p class="text-sm text-slate-600 leading-snug">{item}</p>
              </div>
            ))}
          </div>
          <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20confirmar%20se%20minha%20empresa%20precisa%20de%20PGRS.%20Cidade%3A%20____%20%7C%20Atividade%3A%20____%20%7C%20Setor%3A%20____"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-6 py-3 rounded-full transition-colors text-sm shadow-md">
            <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
            Ver se minha empresa precisa de PGRS
          </a>
        </div>
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100">
          <p class="text-sm font-bold text-[#1a3044] uppercase tracking-wider mb-6">Segmentos que mais atendemos</p>
          <div class="space-y-4">
            {[
              { icon: 'tabler:car', label: 'Oficinas, auto centers e lava-jatos', desc: 'Resíduos perigosos, óleos, filtros e embalagens contaminadas' },
              { icon: 'tabler:crane', label: 'Construtoras e empreiteiras', desc: 'Resíduos de obra, entulho, madeiras e materiais mistos' },
              { icon: 'tabler:building-factory', label: 'Indústrias, metalúrgicas e serralherias', desc: 'Sucatas, carepa, fluidos de corte e resíduos industriais' },
              { icon: 'tabler:truck', label: 'Logística, transportadoras e mineração', desc: 'Resíduos operacionais e exigências de conformidade contratual' },
            ].map(({ icon, label, desc }) => (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
                  <Icon name={icon} class="w-5 h-5 text-[#3a8d44]" />
                </div>
                <div>
                  <p class="text-sm font-bold text-[#1a3044]">{label}</p>
                  <p class="text-xs text-slate-500 leading-relaxed">{desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONSEQUÊNCIAS -->
  <section class="bg-slate-50 py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-orange-500 font-bold tracking-widest uppercase mb-2">Atenção</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">Consequências de operar sem PGRS adequado</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 text-sm">Riscos concretos para empresas sem plano atualizado e implantado.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: 'tabler:receipt-tax', text: 'Multas administrativas por ausência, desatualização ou inadequação do plano' },
          { icon: 'tabler:ban', text: 'Bloqueio ou negativa de renovação de licença ambiental por pendência no PGRS' },
          { icon: 'tabler:file-x', text: 'Irregularidade no Manifesto de Transporte de Resíduos (MTR/CTR) por falta de base documental' },
          { icon: 'tabler:alert-circle', text: 'Responsabilidade solidária por destinação inadequada feita por terceiros contratados' },
          { icon: 'tabler:building-bank', text: 'Perda de contratos com clientes e contratantes que exigem comprovação de conformidade' },
        ].map(({ icon, text }) => (
          <div class="flex items-start gap-4 p-5 bg-white rounded-2xl border border-slate-100 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
              <Icon name={icon} class="w-5 h-5 text-orange-500" />
            </div>
            <p class="text-sm text-slate-600 leading-snug">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- O QUE A TRIAXIS ENTREGA -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-10">
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Entregáveis</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[#1a3044] mb-2">O que a Triaxis entrega no PGRS</h2>
        <div class="w-16 h-1 bg-[#3a8d44] mx-auto rounded-full mb-4"></div>
        <p class="text-slate-500 max-w-xl mx-auto text-sm">
          Pacote completo, adaptado à realidade da sua empresa. Sem modelo genérico.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Fase 1 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-[#1a3044] flex items-center justify-center">
              <span class="text-xs font-black text-[#6fcf7f]">01</span>
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm">Diagnóstico e levantamento</h3>
          </div>
          <div class="space-y-2">
            {[
              'Entendimento do processo/atividade e pontos de geração',
              'Levantamento dos resíduos e estimativas por evidências (compras, notas, histórico)',
              'Avaliação das rotinas atuais (segregação, armazenamento, coleta)',
              'Checagem documental básica: o que existe e o que falta',
            ].map((item) => (
              <div class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-[#3a8d44] flex-shrink-0 mt-1" />
                <p class="text-xs text-slate-600 leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Fase 2 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-[#1a3044] flex items-center justify-center">
              <span class="text-xs font-black text-[#6fcf7f]">02</span>
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm">Elaboração do PGRS</h3>
          </div>
          <div class="space-y-2">
            {[
              'Estrutura conforme exigências aplicáveis (município/estado/contratante)',
              'Diretrizes de segregação, acondicionamento, identificação e armazenamento',
              'Fluxo de movimentação interna e externa de resíduos',
              'Diretrizes de destinação adequada e rastreabilidade documental',
              'Definição de responsabilidades e controles operacionais',
              'Matriz de resíduos (origem, classe, destino, responsável e evidências)',
              'Lista de registros e evidências para auditoria e fiscalização',
            ].map((item) => (
              <div class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-[#3a8d44] flex-shrink-0 mt-1" />
                <p class="text-xs text-slate-600 leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Fase 3 -->
        <div class="bg-slate-50 rounded-2xl p-6 border border-[#3a8d44]/30 relative">
          <div class="absolute -top-3 right-4">
            <span class="bg-[#3a8d44] text-white text-xs font-bold px-3 py-1 rounded-full">Recomendado</span>
          </div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-[#3a8d44] flex items-center justify-center">
              <span class="text-xs font-black text-white">03</span>
            </div>
            <h3 class="font-bold text-[#1a3044] text-sm">Implantação (opcional)</h3>
          </div>
          <div class="space-y-2">
            {[
              'Checklists e procedimentos operacionais simples para a rotina',
              'Orientação prática sobre evidências: como organizar pastas e registros',
              'Treinamento rápido da equipe (presencial ou online)',
              'Indicadores de controle e melhoria (geração, segregação, custos)',
            ].map((item) => (
              <div class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-[#3a8d44] flex-shrink-0 mt-1" />
                <p class="text-xs text-slate-600 leading-relaxed">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Bônus -->
      <div class="bg-[#1a3044]/5 border border-[#1a3044]/10 rounded-2xl p-6 mb-6">
        <div class="flex items-center gap-3 mb-3">
          <Icon name="tabler:gift" class="w-5 h-5 text-[#3a8d44]" />
          <h3 class="font-bold text-[#1a3044] text-sm">Bônus (quando aplicável)</h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="flex items-start gap-2">
            <Icon name="tabler:circle-check" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
            <p class="text-sm text-slate-600">Modelo de planilha de controle de resíduos e evidências</p>
          </div>
          <div class="flex items-start gap-2">
            <Icon name="tabler:circle-check" class="w-4 h-4 text-[#3a8d44] flex-shrink-0 mt-0.5" />
            <p class="text-sm text-slate-600">Checklist "pronto para fiscalização" (auditoria interna rapida)</p>
          </div>
        </div>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-8">
        <p class="text-xs text-amber-700 leading-relaxed">
          <span class="font-bold">Observacao importante:</span> A implantação inclui orientação, treinamento e organização de controles.
          Adequações físicas, contratação de coletores/destinadores e a operação logística são responsabilidades do cliente (a Triaxis pode apoiar com critérios e especificações).
        </p>
      </div>

      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20receber%20o%20escopo%20completo%20do%20PGRS%20(Elabora%C3%A7%C3%A3o%20%2B%20op%C3%A7%C3%A3o%20de%20Implanta%C3%A7%C3%A3o).%20Empresa%3A%20____%20%7C%20Cidade%3A%20____%20%7C%20Atividade%3A%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Receber escopo completo do PGRS
        </a>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="como-atuamos" class="bg-[#1a3044] py-16 px-4">
    <div class="max-w-5xl mx-auto tx-fade">
      <div class="text-center mb-12">
        <p class="text-sm text-[#6fcf7f] font-bold tracking-widest uppercase mb-2">Metodologia</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Como funciona o PGRS na prática (passo a passo)</h2>
        <div class="w-16 h-1 bg-orange-500 mx-auto rounded-full mb-4"></div>
        <p class="text-slate-300 text-sm">Processo simples, organizado e sem burocracia desnecessária.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {[
          { num: '01', titulo: 'Reunião inicial', desc: 'Online ou presencial para entender a operação, atividades, resíduos e urgência' },
          { num: '02', titulo: 'Levantamento de informações', desc: 'Questionário + visita técnica quando necessário; solicitação de documentos e dados' },
          { num: '03', titulo: 'Elaboração do PGRS', desc: 'Conforme realidade da empresa, exigências aplicáveis e boas práticas de gestão' },
          { num: '04', titulo: 'Validação e ajustes', desc: 'Envio do rascunho para revisão e alinhamento com o cliente antes da entrega final' },
          { num: '05', titulo: 'Entrega da versão final', desc: 'PDF + anexos, planilhas e modelos inclusos conforme escopo contratado' },
          { num: '06', titulo: 'Implantação e treinamento', desc: 'Quando contratado: orientação da equipe, checklists operacionais e organização de evidências' },
        ].map(({ num, titulo, desc }) => (
          <div class="bg-white/10 rounded-2xl p-6 border border-white/10">
            <span class="text-2xl font-black text-[#6fcf7f] opacity-70 mb-2 block">{num}</span>
            <h3 class="text-white font-bold text-sm mb-2">{titulo}</h3>
            <p class="text-slate-300 text-xs leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20entender%20como%20funciona%20o%20PGRS%20no%20meu%20caso.%20Cidade%3A%20____%20%7C%20Atividade%3A%20____%20%7C%20Precisa%20protocolar%3F%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-7 py-3.5 rounded-full transition-colors shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
          Entender como funciona no meu caso
        </a>
      </div>
    </div>
  </section>

  <!-- PRAZOS + CHECKLIST -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 tx-fade">

      <!-- Prazos -->
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Prazos</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">Prazo típico do PGRS</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
        <p class="text-slate-600 text-sm leading-relaxed mb-5">
          O prazo varia conforme o porte e a complexidade da operação.
          O cronograma final e confirmado após o levantamento inicial e o recebimento das informações mínimas.
        </p>
        <div class="space-y-3 mb-5">
          {[
            { prazo: 'PGRS (elaboração)', tempo: '7 a 20 dias' },
            { prazo: 'PGRS + implantação', tempo: '15 a 45 dias' },
          ].map(({ prazo, tempo }) => (
            <div class="flex items-center gap-4 p-4 bg-slate-50 rounded-xl border border-slate-100">
              <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
                <Icon name="tabler:clock" class="w-5 h-5 text-[#3a8d44]" />
              </div>
              <div>
                <span class="text-xs font-bold text-[#1a3044] block">{prazo}</span>
                <span class="text-base font-black text-[#3a8d44]">{tempo}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 mb-5">
          <p class="text-xs text-orange-700 font-semibold mb-1">O que pode impactar o prazo:</p>
          <ul class="space-y-1">
            {[
              'Necessidade de complementar informações ou documentos',
              'Operações com muitos tipos de resíduos e frentes de trabalho',
              'Dependência de terceiros (destinadores, transportadores, contratos)',
            ].map((item) => (
              <li class="flex items-start gap-2">
                <Icon name="tabler:point-filled" class="w-3 h-3 text-orange-500 flex-shrink-0 mt-1" />
                <span class="text-xs text-orange-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <a href="https://wa.me/5531994915126?text=Ol%C3%A1!%20Quero%20estimar%20prazo%20do%20meu%20PGRS.%20Cidade%3A%20____%20%7C%20Atividade%3A%20____%20%7C%20Complexidade%3A%20____"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold px-5 py-3 rounded-full transition-colors text-sm shadow-md">
          <Icon name="tabler:brand-whatsapp" class="w-4 h-4" />
          Estimar prazo do meu PGRS
        </a>
      </div>

      <!-- O que precisamos -->
      <div>
        <p class="text-sm text-[#3a8d44] font-bold tracking-widest uppercase mb-2">Para orçamento rápido</p>
        <h2 class="text-xl md:text-2xl font-bold text-[#1a3044] mb-4">O que precisamos da sua empresa</h2>
        <div class="w-12 h-1 bg-[#3a8d44] rounded-full mb-5"></div>
        <p class="text-slate-600 text-sm leading-relaxed mb-5">
